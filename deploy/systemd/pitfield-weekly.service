[Unit]
Description=Pitfield St — weekly study, reading list and publish
Documentation=file:/opt/pitfield/deploy/README.md
After=network-online.target
Wants=network-online.target
OnFailure=pitfield-alert@%n.service

[Service]
Type=oneshot
User=pitfield
Group=pitfield
WorkingDirectory=/opt/pitfield
EnvironmentFile=-/etc/pitfield/env
Environment=PITFIELD_WWW=/var/www/pitfield
# ProtectHome=true below denies the home directory, and Astro's telemetry tries
# to read and write a config file there during `npm run build`. It throws, the
# build dies, and the publish step fails with "cannot stat site/dist/." -- so
# every scheduled publish breaks while the deploy, run without this hardening,
# succeeds. Point HOME somewhere writable and switch the telemetry off: a
# server publishing a research archive has no business phoning home anyway.
Environment=HOME=/opt/pitfield
Environment=ASTRO_TELEMETRY_DISABLED=1
ExecStart=/opt/pitfield/scripts/weekly_research.sh
# Two thousand bootstrap resamples across 168 tests is the long pole here.
TimeoutStartSec=4h

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pitfield /var/www/pitfield
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
