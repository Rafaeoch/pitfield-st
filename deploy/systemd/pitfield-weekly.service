[Unit]
Description=Pitfield St — weekly study, reading list and publish
Documentation=file:/opt/pitfield/deploy/README.md
After=network-online.target
Wants=network-online.target
OnFailure=pitfield-alert@%n.service

[Service]
Type=oneshot
User=pitfield
Group=pitfield
WorkingDirectory=/opt/pitfield
EnvironmentFile=-/etc/pitfield/env
Environment=PITFIELD_WWW=/var/www/pitfield
ExecStart=/opt/pitfield/scripts/weekly_research.sh
# Two thousand bootstrap resamples across 168 tests is the long pole here.
TimeoutStartSec=4h

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pitfield /var/www/pitfield
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
