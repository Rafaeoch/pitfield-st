---
/**
 * Base layout: the frame every page sits in.
 *
 * Set the way a research firm sets its site rather than the way a product
 * sets a dashboard. Navigation is a quiet tree down the right-hand side, not a
 * bar across the top: it lists the pages, opens the current one to show its
 * sections, and follows the reader down the page. The name runs up the left
 * edge. Everything between is a report: numbered sections, large plain prose
 * on a white page, and colour used in whole blocks rather than sprinkled.
 *
 * Two grounds. White for pages that are read, charcoal for the front door and
 * the library. A charcoal block can also sit inside a white page, which is how
 * the interactive figures are framed: they were drawn for a dark ground and
 * are shown on one.
 *
 * Ultra Violet does the work a corporate blue would. It reads at 7.3:1 on
 * white, so on the white pages it can carry links, the active item and whole
 * callout blocks with white text on them. On charcoal it cannot, at 2.1:1, so
 * there the accent is the same hue lifted.
 */
interface SectionLink { id?: string; href?: string; label: string }
interface Props {
  title: string;
  description?: string;
  /** The page ground. */
  theme?: 'light' | 'dark';
  /** Sections of this page, listed under its entry in the navigation. */
  sections?: SectionLink[];
  /** The first screen runs edge to edge, under the navigation. Homepage. */
  bleed?: boolean;
}
const {
  title,
  description,
  theme = 'light',
  sections = [],
  bleed = false,
} = Astro.props;
import Mark from '../components/Mark.astro';

const path = Astro.url.pathname;
const site = Astro.site ?? new URL('https://pitfieldstresearch.com');
const canonical = new URL(path, site).href;

// Numbered as the sections of a report are, and the numbers are the ones each
// page carries on its own title.
const primary = [
  { href: '/', label: 'Today', no: '1' },
  { href: '/vol/SPY/', label: 'Surface', no: '2' },
  { href: '/quality/', label: 'Quality', no: '3' },
  { href: '/methodology/', label: 'Methodology', no: '4' },
  { href: '/about/', label: 'About', no: '5' },
];
// Behind a gap, and unnumbered. The studies are real work but they are not
// market data, and a visitor whose first impression is astrology stops reading
// the volatility archive as serious.
const secondary = [
  { href: '/studies/', label: 'Studies' },
  { href: '/reading/', label: 'Reading' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<html lang="en" class={`theme-${theme}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · Pitfield St</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    {/* A public archive gets cited and shared. Without these a link posted
        anywhere renders as a bare URL, which reads as provisional. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pitfield St" />
    <meta property="og:title" content={`${title} · Pitfield St`} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pitfield St, a public archive of computed options-derived volatility data" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', site).href} />
    <meta name="twitter:title" content={`${title} · Pitfield St`} />
    {description && <meta name="twitter:description" content={description} />}

    <meta name="theme-color" content={theme === 'dark' ? '#252525' : '#ffffff'} />
    <meta name="author" content="Pitfield St" />
    {/* Scholarly indexers read these; the archive is meant to be citable. */}
    <meta name="citation_title" content={`${title} · Pitfield St`} />
    <meta name="citation_public_url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Figtree for everything that is read, Source Serif for the few things
        that are quoted or called out, and a mono only for code. */}
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,500;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;1,8..60,400&family=IBM+Plex+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
    <noscript><style>.rail-nav { display: block !important; }</style></noscript>
  </head>
  <body class={bleed ? 'is-bleed' : ''}>
    <a class="skip" href="#main">Skip to content</a>

    <a class="edge" href="/" aria-label="Pitfield St, home">Pitfield St</a>

    <aside class="rail">
      <div class="rail-top">
        <a class="rail-mark" href="/" aria-label="Pitfield St, home">
          <Mark size={40} />
        </a>
        <button class="rail-toggle" type="button" aria-expanded="false" aria-controls="rail-nav">
          Menu
        </button>
      </div>

      <nav class="rail-nav" id="rail-nav" aria-label="Primary">
        <ul class="tree">
          {primary.map((item) => {
            const active = isActive(item.href);
            const open = active && sections.length > 0;
            return (
              <li class={item.href === '/' ? 'leaf' : 'branch'} data-open={open ? 'true' : undefined}>
                <a href={item.href} aria-current={active ? 'page' : undefined}>{item.label}</a>
                {open && (
                  <ul class="twigs">
                    {sections.map((s) => (
                      <li><a href={s.href ?? `#${s.id}`} data-spy={s.id}>{s.label}</a></li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })}
        </ul>

        <ul class="tree tree--secondary">
          {secondary.map((item) => {
            const active = isActive(item.href);
            const open = active && sections.length > 0;
            return (
              <li class="leaf" data-open={open ? 'true' : undefined}>
                <a href={item.href} aria-current={active ? 'page' : undefined}>{item.label}</a>
                {open && (
                  <ul class="twigs">
                    {sections.map((s) => (
                      <li><a href={s.href ?? `#${s.id}`} data-spy={s.id}>{s.label}</a></li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })}
        </ul>

        <p class="rail-util">
          <a href="https://github.com/Rafaeoch/pitfield-st">Source code</a>
          <a href="/data/index.json">Data index</a>
        </p>
      </nav>
    </aside>

    <main id="main">
      <slot />

      <footer class="foot">
        <div class="foot-cols">
          <section>
            <h2>Source</h2>
            <p>
              Every number here is reproducible from the code and the public
              inputs. <a href="https://github.com/Rafaeoch/pitfield-st">The
              repository</a> holds the pipeline, the test suite and the frozen
              pre-registration.
            </p>
          </section>
          <section>
            <h2>Public inputs</h2>
            <p>
              Index history and the Treasury curve from
              <a href="https://fred.stlouisfed.org/">FRED</a>, geomagnetic Kp
              from <a href="https://kp.gfz-potsdam.de/">GFZ Potsdam</a>, sunspots
              from <a href="https://www.sidc.be/SILSO/">SILSO</a>, ephemerides
              from <a href="https://naif.jpl.nasa.gov/naif/">JPL DE440s</a>,
              literature from <a href="https://openalex.org/">OpenAlex</a>.
              Options chains are licensed and never redistributed; only values
              derived from them are published.
            </p>
          </section>
          <section>
            <h2>Citing this archive</h2>
            <p>
              Cite the dated record rather than the site, since the archive
              grows and is never overwritten:
              <code>Pitfield St, &lt;page&gt;, retrieved &lt;date&gt;,
              pitfieldstresearch.com</code>
            </p>
          </section>
        </div>
        <p class="foot-fine">
          Code released under the MIT licence. Published figures may be reused
          with attribution. Not investment advice, and no claim of predictive
          value. Nothing here is an offer, a solicitation, or a recommendation
          to trade.
        </p>
      </footer>
    </main>

    <style is:global>
      :root {
        --charcoal: #252525;
        --paper: #ffffff;
        /* The backdrop grey of a secondary page, and the fill of a set-aside
           box: black at 8% over white. */
        --mist: #ebebeb;

        /* Pantone Ultra Violet and its family. Spot colours have no exact sRGB
           equivalent; these are the standard approximations. */
        --violet: #5F4B8B;          /* Ultra Violet 18-3838: 7.3:1 on white */
        --violet-lift: #B8ACD2;     /* the same hue, 7.2:1 on charcoal */
        --grape: #8B4A8B;           /* Sparkling Grape 19-3336 */
        --mulberry: #A96FA5;        /* Mulberry 17-3014 */
        --jacaranda: #7D8BC7;       /* Jacaranda 17-3930 */
        --rhapsody: #A093C0;        /* Rhapsody 16-3817 */
        --red-violet: #A85C82;      /* Red Violet 17-1818 */
        --chateau: #D9738F;         /* Chateau Rose 17-2120 */
        --prism: #F0A6CE;           /* Prism Pink 14-2311 */

        --sans: 'Figtree', 'Helvetica Neue', Helvetica, Arial, sans-serif;
        --serif: 'Source Serif 4', Georgia, 'Times New Roman', serif;
        --mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

        --rail: 220px;
        --gutter: 60px;
        /* Prose. Large, as a report is set when it expects to be read rather
           than skimmed; the line is kept short enough to carry it. */
        --read: clamp(1.19rem, 0.6rem + 1.25vw, 1.516rem);
        --read-lh: 1.25;
        --label: 0.875rem;
      }

      /* Each ground publishes the same names, so anything set in them follows
         whichever ground it lands on, including a dark block inside a white
         page. Declared on the ground itself rather than on :root, because a
         custom property that refers to another is resolved where it is
         declared: set once at the root, a block could never override it. */
      .theme-light, .light {
        --ground: var(--paper);
        --type: #252525;
        --type-muted: #6b6b6b;      /* 5.3:1; the reference greys fail AA */
        --rule: #d2d2d2;
        --panel: #f2f2f2;
        --accent: var(--violet);
        --fault: #b3412a;           /* 5.7:1 */
      }
      .theme-dark, .dark {
        --ground: var(--charcoal);
        --type: #ffffff;
        --type-muted: #a8a8a8;      /* 6.5:1 */
        --rule: #4a4a4a;
        --panel: #2e2e2e;
        --accent: var(--violet-lift);
        --fault: #e07a5f;           /* 5.2:1 */
      }
      .dark, .light { color: var(--type); background: var(--ground); }

      * { box-sizing: border-box; }
      html { background: var(--ground); color-scheme: light; }
      html.theme-dark { color-scheme: dark; }

      body {
        margin: 0;
        background: var(--ground);
        color: var(--type);
        font-family: var(--sans);
        font-size: 16px;
        line-height: 1.45;
        font-weight: 400;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--accent);
        color: var(--paper);
        padding: 0.6rem 1rem;
        z-index: 100;
      }
      .skip:focus { left: 0; }

      a:focus-visible,
      button:focus-visible,
      summary:focus-visible,
      [tabindex]:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; text-underline-offset: 0.18em; text-decoration-thickness: 1px; }

      /* ---- the left edge -------------------------------------------------
         The name, turned up the margin and fixed there. It is the only place
         the name is set in type, so it is set in the serif. */
      .edge {
        position: fixed;
        z-index: 30;
        left: 16px;
        top: 50%;
        /* Read bottom to top. Shifted half its own length first, so it is
           centred on the screen whatever its length. */
        transform-origin: 0 0;
        transform: rotate(-90deg) translateX(-50%);
        font-family: var(--serif);
        font-size: 15px;
        letter-spacing: 0.02em;
        white-space: nowrap;
        color: var(--type);
        text-decoration: none;
      }
      .edge:hover { text-decoration: none; color: var(--accent); }

      /* ---- the rail --------------------------------------------------------
         A tree down the right-hand side. Pages are listed at reading size;
         the current page opens to list its sections at label size, and the
         section being read is picked out as the reader scrolls. */
      .rail {
        position: fixed;
        z-index: 30;
        top: 0;
        right: 0;
        width: var(--rail);
        height: 100vh;
        padding: 30px 20px 30px 25px;
        overflow-y: auto;
        scrollbar-width: none;
      }
      .rail-top { height: 71px; }
      .rail-mark { display: inline-block; }
      .rail-mark:hover { text-decoration: none; }
      .rail-toggle { display: none; }

      .tree { list-style: none; margin: 0; padding: 0; }
      .tree > li { position: relative; }
      .tree > li > a {
        display: block;
        font-size: 18px;
        line-height: 26px;
        color: var(--type);
      }
      .tree > li > a:hover { color: var(--accent); text-decoration: none; }
      .tree > li > a[aria-current='page'] { color: var(--accent); }
      /* A chevron for pages that have sections, turned down on the open one. */
      .branch::before {
        content: '';
        position: absolute;
        left: -15px;
        top: 10px;
        width: 5px;
        height: 5px;
        border-right: 1px solid var(--accent);
        border-bottom: 1px solid var(--accent);
        transform: rotate(-45deg);
        transition: transform 180ms ease;
      }
      .branch[data-open]::before { transform: rotate(45deg); top: 8px; }

      .twigs {
        list-style: none;
        margin: 2px 0 6px;
        padding: 0;
      }
      .twigs a {
        display: block;
        font-size: 13px;
        line-height: 18px;
        padding: 1px 0;
        color: var(--type-muted);
      }
      .twigs a:hover { color: var(--type); text-decoration: none; }
      .twigs a[aria-current='true'] { color: var(--type); font-weight: 500; }

      .tree--secondary { margin-top: 26px; }

      .rail-util {
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin: 26px 0 0;
      }
      .rail-util a {
        font-size: var(--label);
        line-height: 20px;
        color: var(--type-muted);
      }
      .rail-util a:hover { color: var(--type); text-decoration: none; }

      /* ---- the page ------------------------------------------------------
         Ten columns between the left margin and the rail. Prose holds the
         middle eight; blocks, figures and callouts take all ten; section
         numbers hang in the first. */
      main {
        position: relative;
        margin-right: var(--rail);
        padding: 101px 33px 0 var(--gutter);
        min-height: 100vh;
      }
      .is-bleed main { margin-right: 0; padding: 0; }

      /* The column is padding on the page rather than margins on what it
         holds, so a component that sets its own margins cannot knock itself
         out of the column. A full-width block steps back out: 10% of the
         page is 12.5% of the column it sits in. */
      .page {
        max-width: 1100px;
        padding: 0 10% 4rem;
      }
      .page > .full { margin-left: -12.5%; margin-right: -12.5%; }

      /* ---- type ------------------------------------------------------------ */
      h1, h2, h3, h4 { font-weight: 400; margin: 0; }

      .sh { position: relative; }
      .sh-no {
        position: absolute;
        right: 100%;
        margin-right: 1.9rem;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }
      .sh--1 {
        font-size: clamp(1.9rem, 1.2rem + 1.6vw, 2.37rem);
        line-height: 1.25;
        margin-block: 0 2.2rem;
      }
      .sh--1 .sh-no { margin-right: 2.4rem; }
      .sh--2 {
        font-size: 1.086rem;
        line-height: 1.45;
        margin-block: 5rem 1.5rem;
      }
      .sh--3 {
        font-size: clamp(1.3rem, 0.9rem + 0.9vw, 1.75rem);
        line-height: 1.2;
        color: var(--accent);
        margin-block: 2.6rem 0.9rem;
      }

      /* Prose is what sits directly in the page or in a block. Components
         keep their own type: a rule reaching every paragraph on the page
         would set a chart's legend at reading size. */
      :is(.page, .block) > :is(p, ul > li, ol > li) {
        font-size: var(--read);
        line-height: var(--read-lh);
      }
      :is(.page, .block) > p { margin-block: 0 1.2em; }
      /* The first paragraph under a heading is indented, as a printed report
         sets it. Only the first: the rest are separated by space. */
      .sh + p { text-indent: 12.5%; }

      :is(.page, .block) > ul {
        list-style: none;
        margin-block: 0 1.4em;
        padding: 0;
        border-top: 1px solid var(--rule);
      }
      :is(.page, .block) > ul > li {
        position: relative;
        padding: 0.7em 0 0.7em 2.6rem;
        border-bottom: 1px solid var(--rule);
      }
      :is(.page, .block) > ul > li::before {
        content: '';
        position: absolute;
        left: 0.4rem;
        top: 1.25em;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--type);
      }

      .muted { color: var(--type-muted); }
      :is(.page, .block) > p.small, .small { font-size: 1rem; line-height: 1.5; }
      :is(.page, .block) > p.note, .note { font-size: 1rem; line-height: 1.5; color: var(--type-muted); }

      code {
        font-family: var(--mono);
        font-size: 0.86em;
      }
      .num { font-variant-numeric: tabular-nums; }
      .nowrap { white-space: nowrap; }

      /* ---- blocks ----------------------------------------------------------
         Colour arrives in whole blocks. A callout is Ultra Violet with white
         serif type on it; a dark block is charcoal, and frames the figures
         that were drawn for a dark ground. */
      .callout {
        background: var(--violet);
        color: #fff;
        padding: clamp(2rem, 4vw, 3.4rem) 10%;
        margin-top: 3rem;
        margin-bottom: 3rem;
      }
      .callout p {
        font-family: var(--serif);
        font-size: var(--read);
        line-height: var(--read-lh);
        text-align: center;
        text-indent: 0;
        margin: 0 0 0.9em;
      }
      .callout p:last-child { margin-bottom: 0; }
      .callout a { color: #fff; text-decoration: underline; text-underline-offset: 0.18em; }

      .block {
        padding: clamp(2rem, 4vw, 3.4rem) 10%;
        margin-top: 3rem;
        margin-bottom: 3rem;
      }
      .block > .sh--2:first-child { margin-top: 0; }
      .block.dark .sh-no { color: var(--type); }
      .serif { font-family: var(--serif); }

      /* Two set-aside boxes, overlapped and stepped, for a pair of ideas that
         belong side by side. */
      .stagger {
        position: relative;
        display: grid;
        grid-template-columns: 52% 52%;
        margin-top: 2.6rem;
        margin-bottom: 7rem;
      }
      .stagger > * {
        background: rgba(0, 0, 0, 0.08);
        padding: 2.6rem 3.2rem 3rem;
      }
      .theme-dark .stagger > *, .dark .stagger > * { background: rgba(255, 255, 255, 0.07); }
      .stagger > :nth-child(2) { margin-left: -8%; transform: translateY(6.5rem); }
      .stagger h3 {
        font-size: var(--read);
        line-height: 1.25;
        margin: 0 0 1.1rem;
      }
      .stagger p {
        font-size: 1.086rem;
        line-height: 1.45;
        text-indent: 2.4rem;
        margin: 0;
      }

      /* A link set as a block, with a long rule for an arrow. */
      .arrow-card {
        display: block;
        position: relative;
        background: var(--violet);
        color: #fff;
        font-family: var(--serif);
        font-size: var(--read);
        line-height: var(--read-lh);
        padding: 2.2rem 2.4rem 4.6rem;
        text-decoration: none;
      }
      .arrow-card:hover { text-decoration: none; background: #4f3d78; }
      .arrow-card::after {
        content: '';
        position: absolute;
        left: 2.4rem;
        right: 2.4rem;
        bottom: 2.2rem;
        height: 1px;
        background: currentColor;
        transition: right 220ms ease;
      }
      .arrow-card::before {
        content: '';
        position: absolute;
        right: 2.4rem;
        bottom: calc(2.2rem - 5px);
        width: 10px;
        height: 10px;
        border-top: 1px solid currentColor;
        border-right: 1px solid currentColor;
        transform: rotate(45deg);
        transform-origin: center;
        transition: right 220ms ease;
      }
      .arrow-card:hover::after { right: 1.6rem; }
      .arrow-card:hover::before { right: 1.6rem; }

      /* Figures in a row: large, plain numbers with a label above. */
      .figures {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
        gap: 2.2rem 2rem;
        margin: 2.4rem 0 3rem;
        padding: 0;
      }
      .figures > div { border-top: 1px solid var(--rule); padding-top: 0.9rem; }
      .figures dt {
        font-size: var(--label);
        color: var(--type-muted);
        margin-bottom: 0.5rem;
      }
      .figures dd {
        margin: 0;
        font-size: clamp(1.9rem, 1.2rem + 1.6vw, 2.37rem);
        line-height: 1.1;
        font-variant-numeric: tabular-nums;
      }
      .figures dd small { font-size: 1rem; color: var(--type-muted); margin-left: 0.35rem; }

      /* ---- tables ---------------------------------------------------------- */
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 1rem;
        font-variant-numeric: tabular-nums;
      }
      th, td {
        text-align: left;
        padding: 0.72rem 1.1rem 0.72rem 0;
        border-bottom: 1px solid var(--rule);
        vertical-align: baseline;
      }
      thead th {
        font-weight: 400;
        font-size: var(--label);
        color: var(--type-muted);
        white-space: nowrap;
        border-bottom-color: var(--type);
      }
      tbody th { font-weight: 400; }
      td.n, th.n { text-align: right; padding-right: 0; }
      td.n + td, th.n + th { padding-left: 1.4rem; }
      .table-scroll { overflow-x: auto; }
      .pair {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
        gap: 0 3rem;
        align-items: start;
        margin-bottom: 1.6rem;
      }

      .fault { color: var(--fault); }
      .ok { color: var(--accent); }

      /* A page that is telling you what it is, rather than an error. */
      .banner {
        border-left: 3px solid var(--fault);
        padding: 0.1rem 0 0.1rem 1.4rem;
        margin: 0 0 3rem;
      }
      .banner strong {
        display: block;
        color: var(--fault);
        font-weight: 500;
        font-size: 1rem;
        margin-bottom: 0.4rem;
      }
      .banner p {
        font-size: 1rem;
        line-height: 1.5;
        margin: 0.35rem 0 0;
        text-indent: 0;
      }

      .chart { margin: 1.4rem 0 0; min-height: 240px; }
      .chart svg { max-width: 100%; height: auto; }
      .chart figure { margin: 0; }

      /* ---- footer ---------------------------------------------------------- */
      .foot {
        max-width: 1100px;
        padding: 4rem 0 3rem;
        color: var(--type-muted);
        font-size: var(--label);
        line-height: 20px;
      }
      .is-bleed .foot { padding-left: var(--gutter); padding-right: calc(var(--rail) + 33px); max-width: none; }
      .foot-cols {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
        gap: 1.4rem 2.6rem;
        padding-top: 1.4rem;
        border-top: 1px solid var(--rule);
      }
      .foot h2 { font-size: var(--label); color: var(--type); margin: 0 0 0.4rem; }
      .foot p { margin: 0; }
      .foot a { color: var(--type-muted); text-decoration: underline; text-underline-offset: 0.18em; }
      .foot a:hover { color: var(--type); }
      .foot code { display: block; margin-top: 0.4rem; color: var(--type); font-size: 12px; }
      .foot-fine {
        margin-top: 1.8rem !important;
        font-size: 11px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      /* ---- narrow screens --------------------------------------------------
         The rail becomes a bar across the top with the mark and a menu, the
         name leaves the edge, and numbers stop hanging in a margin that is no
         longer there. */
      @media (max-width: 1000px) {
        .edge { display: none; }
        .rail {
          position: sticky;
          width: 100%;
          height: auto;
          padding: 14px 20px;
          background: var(--ground);
          border-bottom: 1px solid var(--rule);
          overflow: visible;
        }
        .is-bleed .rail { position: fixed; background: transparent; border-bottom-color: transparent; }
        .is-bleed.menu-open .rail { background: var(--ground); }
        .rail-top {
          height: auto;
          display: flex;
          align-items: center;
          justify-content: space-between;
        }
        .rail-mark svg { width: 78px; height: 30px; }
        .rail-toggle {
          display: block;
          font: inherit;
          font-size: 16px;
          background: none;
          border: 1px solid var(--rule);
          color: var(--type);
          padding: 0.35rem 0.9rem;
          cursor: pointer;
        }
        .rail-nav { display: none; padding: 1.4rem 0 0.6rem 18px; }
        .menu-open .rail-nav { display: block; }

        main { margin-right: 0; padding: 2.4rem 20px 0; }
        .page { padding-left: 0; padding-right: 0; }
        .page > .full { margin-left: 0; margin-right: 0; }
        .sh-no { position: static; margin-right: 0.7em; }
        .sh--1 .sh-no { margin-right: 0.6em; }
        .sh + p { text-indent: 0; }
        .stagger { grid-template-columns: 1fr; margin-bottom: 3rem; }
        .stagger > :nth-child(2) { margin: 0; transform: none; }
        .callout, .block { padding-left: 1.4rem; padding-right: 1.4rem; }
        .is-bleed .foot { padding-left: 20px; padding-right: 20px; }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.001ms !important;
          transition-duration: 0.001ms !important;
        }
      }
    </style>

    <script>
      // The menu, on narrow screens. Without JavaScript the list is simply
      // shown (see the noscript rule in the head).
      const toggle = document.querySelector<HTMLButtonElement>('.rail-toggle');
      const setMenu = (open: boolean) => {
        document.body.classList.toggle('menu-open', open);
        toggle?.setAttribute('aria-expanded', String(open));
        if (toggle) toggle.textContent = open ? 'Close' : 'Menu';
      };
      toggle?.addEventListener('click', () => setMenu(!document.body.classList.contains('menu-open')));
      // A section link jumps within the page; the menu should not stay open
      // over the place it jumped to.
      for (const a of document.querySelectorAll('.rail-nav a')) {
        a.addEventListener('click', () => setMenu(false));
      }

      // Pick out the section being read. The last section whose heading has
      // passed a line a third of the way down the screen is the current one:
      // near the top of a section its heading is visible, deep inside a long
      // one it is not, and both should read as being in that section.
      const links = [...document.querySelectorAll<HTMLAnchorElement>('.twigs a[data-spy]')];
      const targets = links
        .map((a) => document.getElementById(a.dataset.spy || ''))
        .filter((el): el is HTMLElement => !!el);
      if (targets.length) {
        let queued = false;
        const update = () => {
          queued = false;
          const line = window.innerHeight / 3;
          let current: string | null = null;
          for (const t of targets) {
            if (t.getBoundingClientRect().top <= line) current = t.id;
          }
          for (const a of links) {
            if (a.dataset.spy === current) a.setAttribute('aria-current', 'true');
            else a.removeAttribute('aria-current');
          }
        };
        addEventListener('scroll', () => {
          if (!queued) { queued = true; requestAnimationFrame(update); }
        }, { passive: true });
        update();
      }
    </script>
  </body>
</html>
