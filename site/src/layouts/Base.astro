---
/**
 * Base layout: palette, type, chrome.
 *
 * The palette is grounded in the subject rather than chosen. Observatories
 * light their floors amber and red so astronomers keep dark adaptation, which
 * is the literal reason the accent here is amber on a blue-shifted night
 * ground. The accent itself is sampled from the magma ramp used for the
 * volatility surface, so the interactive colour is the data colormap rather
 * than a brand decision.
 */
interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}
const { title, description, wide = false } = Astro.props;
import Mark from '../components/Mark.astro';
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site ?? 'https://pitfieldstresearch.com').href;

const nav = [
  { href: '/', label: 'Today' },
  { href: '/vol/SPY/', label: 'Surface' },
  { href: '/quality/', label: 'Quality' },
  { href: '/methodology/', label: 'Methodology' },
  { href: '/about/', label: 'About' },
];
// Behind the divider, and deliberately. The studies are real work, but they
// are not market data, and a visitor whose first impression is astrology stops
// reading the volatility archive as serious. The moon sits inside the studies
// rather than beside them: it is one hypothesis family among thirty and the
// best known rather than the most important, which is why it was never a
// sensible parent for eclipses, Kp, sunspots and the calendar controls.
const curiosities = [
  { href: '/studies/', label: 'Studies' },
  { href: '/reading/', label: 'Reading' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · Pitfield St</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    {/* A public archive gets cited and shared. Without these a link posted
        anywhere renders as a bare URL, which reads as provisional. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pitfield St" />
    <meta property="og:title" content={`${title} · Pitfield St`} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site ?? 'https://pitfieldstresearch.com').href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pitfield St, a public archive of computed options-derived volatility data" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site ?? 'https://pitfieldstresearch.com').href} />
    <meta name="twitter:title" content={`${title} · Pitfield St`} />
    {description && <meta name="twitter:description" content={description} />}

    <meta name="theme-color" content="#0b1017" />
    <meta name="author" content="Pitfield St" />
    {/* Scholarly indexers read these; the archive is meant to be citable. */}
    <meta name="citation_title" content={`${title} · Pitfield St`} />
    <meta name="citation_public_url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,400;7..72,500;7..72,600&family=Spectral:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <a class="wordmark" href="/">
        <Mark size={62} />
        <span class="wordmark-text">
          <span class="wordmark-name">Pitfield St</span>
          <span class="wordmark-sub">Derivatives data archive</span>
        </span>
      </a>
      <nav aria-label="Primary">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
          <li class="nav-group" aria-hidden="true"></li>
          {curiosities.map((item) => (
            <li>
              <a
                class="nav-secondary"
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main" class={wide ? 'wide' : ''}>
      <slot />
    </main>

    <footer>
      <p class="foot-lede">
        Pitfield St publishes computed derivatives data and the code that
        produced it. It is not investment advice, and it makes no claim of
        predictive value.
      </p>

      <div class="foot-grid">
        <section>
          <h3>Source</h3>
          <p>
            Every number here is reproducible from the code and the public
            inputs below. <a href="https://github.com/Rafaeoch/pitfield-st">The
            repository</a> holds the pipeline, the test suite and the frozen
            pre-registration.
          </p>
        </section>

        <section>
          <h3>Public inputs</h3>
          <p>
            Index history and the Treasury curve from
            <a href="https://fred.stlouisfed.org/">FRED</a>, geomagnetic Kp from
            <a href="https://kp.gfz-potsdam.de/">GFZ Potsdam</a>, sunspot numbers
            from <a href="https://www.sidc.be/SILSO/">SILSO, Royal Observatory of
            Belgium</a>, planetary and lunar positions from
            <a href="https://naif.jpl.nasa.gov/naif/">JPL DE440s</a>, literature
            from <a href="https://openalex.org/">OpenAlex</a>. Options chains are
            licensed and are never redistributed; only values derived from them
            are published.
          </p>
        </section>

        <section>
          <h3>Citing this archive</h3>
          <p>
            Cite the dated record rather than the site, since the archive grows
            and is never overwritten:<br />
            <code>Pitfield St, <em>&lt;page&gt;</em>, retrieved
            &lt;date&gt;, pitfieldstresearch.com</code>
          </p>
        </section>
      </div>

      <p class="foot-fine">
        Code released under the MIT licence. Published figures may be reused
        with attribution. Nothing here is an offer, a solicitation, or a
        recommendation to trade.
      </p>
    </footer>

    <style is:global>
      :root {
        --void: #0b1017;
        --panel: #141c26;
        --rule: #26313d;
        --type: #e6e3db;
        --type-muted: #8a96a3;
        /* Ultra Violet and its family. Pantone spot colours have no exact
           sRGB equivalent, so these are the standard approximations.

           Ultra Violet itself is 18-3838 #5F4B8B. It carries the identity but
           cannot carry text: against this ground it measures 2.60:1, which
           fails even the relaxed 3:1 threshold for large text and UI. So the
           accent is the same hue at 259 degrees lightened until it clears
           4.5:1, and Ultra Violet is kept for the mark and for fills where
           nothing has to be read off it. */
        /* Three grounds, so a long page reads as blocks rather than one
           unbroken scroll. Steps of 1.18 and 1.13 in relative luminance: far
           enough apart to see, close enough that body text stays above 12:1 on
           every one of them. The third is violet-tinted rather than another
           grey, so the palette shows up in the structure and not only in the
           accents. */
        --ground-1: #0b1017;
        --ground-2: #18212E;
        --ground-3: #1F1540;

        --violet: #5F4B8B;          /* Ultra Violet 18-3838, the anchor */
        --accent: #8E7AB8;          /* same hue, legible: 5.11:1 */
        --accent-bright: #B8ACD2;   /* 8.97:1, for emphasis on dark panels */
        --grape: #8B4A8B;           /* Sparkling Grape 19-3336 */
        --mulberry: #A96FA5;        /* Mulberry 17-3014 */
        --jacaranda: #7D8BC7;       /* Jacaranda 17-3930 */
        --rhapsody: #A093C0;        /* Rhapsody 16-3817 */
        --red-violet: #A85C82;      /* Red Violet 17-1818 */
        --chateau: #D9738F;         /* Chateau Rose 17-2120 */
        --prism: #F0A6CE;           /* Prism Pink 14-2311 */

        /* Kept so nothing that still asks for the old token breaks; it now
           resolves to the accent rather than to amber. */
        --amber: var(--accent);
        --fault: #c4553d;

        --measure: 66ch;
        --serif: 'Literata', Georgia, 'Times New Roman', serif;
        --display: 'Spectral', Georgia, serif;
        --mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

        /* A modular scale rather than ad-hoc sizes. Everything on the site
           lands on one of these, which is most of what separates a considered
           page from an assembled one. */
        --step--1: 0.855rem;
        /* The scale was cautious: section headings topped out near 23px where
           the sites this is measured against set theirs at 64. The confidence
           of those pages is mostly type size, and the jumps between steps
           matter as much as the sizes -- a scale that climbs gently reads as
           documentation however well it is set. */
        --step-0: 1rem;
        --step-1: 1.18rem;
        --step-2: clamp(1.7rem, 3.2vw, 2.9rem);
        --step-3: clamp(2.1rem, 4.2vw, 3.4rem);
        /* Page titles. The existing scale topped out at a size that reads as a
           section heading, which is why every interior page opened quietly. */
        --step-4: clamp(2.6rem, 6.4vw, 5.2rem);
      }

      * { box-sizing: border-box; }

      html { color-scheme: dark; }

      body {
        margin: 0;
        /* A single, very slight vertical lift behind the page. Enough to stop
           the ground reading as flat black; not enough to notice as a
           gradient. */
        background:
          radial-gradient(120% 70% at 50% 0%, #0e141d 0%, var(--void) 58%)
          no-repeat var(--void);
        color: var(--type);
        font-family: var(--serif);
        font-size: 17px;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--amber);
        color: var(--void);
        padding: 0.6rem 1rem;
        z-index: 100;
      }
      .skip:focus { left: 0; }

      /* Focus must be visible everywhere. Accessibility is an acceptance
         criterion, not a finishing touch. */
      a:focus-visible,
      button:focus-visible,
      [tabindex]:focus-visible {
        outline: 2px solid var(--amber);
        outline-offset: 2px;
      }

      .masthead {
        display: flex;
        flex-wrap: wrap;
        gap: 1.2rem 2.5rem;
        align-items: center;
        justify-content: space-between;
        padding: 1.5rem clamp(1rem, 4vw, 3rem);
        border-bottom: 1px solid var(--rule);
      }

      .wordmark {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        text-decoration: none;
        color: var(--type);
      }
      .wordmark-text { display: block; }
      /* Spectral for the name only. It steps back and lets the mark hold the
         weight, where Literata's sturdiness competed with the fine dot work.
         Body text stays Literata throughout. */
      .wordmark-name {
        display: block;
        font-family: var(--display);
        font-size: 1.16rem;
        font-weight: 500;
        letter-spacing: 0.004em;
        line-height: 1.2;
      }
      .wordmark-sub {
        display: block;
        font-family: var(--display);
        font-size: 0.76rem;
        color: var(--type-muted);
        letter-spacing: 0.028em;
        margin-top: 0.12rem;
      }

      /* Small, widely spaced, low contrast. A navigation bar that competes
         with the page is the clearest sign nobody edited it: the firms this
         is measured against give theirs seven quiet words and a lot of air.
         The tracking is what does the work, not the size. */
      nav ul {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 2.1rem;
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 0.76rem;
        letter-spacing: 0.075em;
        text-transform: uppercase;
      }
      nav a {
        color: var(--type-muted);
        text-decoration: none;
        padding-bottom: 3px;
        border-bottom: 1px solid transparent;
        transition: color 160ms ease, border-color 160ms ease;
      }
      nav a:hover { color: var(--type); }
      nav a[aria-current='page'] {
        color: var(--type);
        border-bottom-color: var(--amber);
      }
      /* Reading sits behind a divider and reads as secondary. If a
         visitor's first impression is astrology, the volatility work stops
         reading as serious. */
      .nav-group {
        width: 1px;
        height: 1.1em;
        background: var(--rule);
      }
      .nav-secondary { font-style: italic; }

      /* The measure the page is set on, drawn faintly behind every page. An
         engineering-led site shows its grid; a marketing site hides it. */
      main {
        position: relative;
        max-width: 78rem;
        margin: 0 auto;
        padding: clamp(2.4rem, 6vw, 5rem) clamp(1rem, 4vw, 3rem) 7rem;
      }
      main.wide { max-width: none; padding-left: 0; padding-right: 0; }
      main::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background-image: repeating-linear-gradient(
          to right,
          var(--rule) 0 1px,
          transparent 1px calc(100% / 12)
        );
        opacity: 0.30;
      }
      main.wide::before { display: none; }
      main > * { position: relative; z-index: 1; }

      /* Full-bleed section grounds. The band spans the viewport while its
         contents stay on the measure. */
      .band {
        position: relative;
        width: 100vw;
        margin-left: calc(50% - 50vw);
        padding-left: calc(50vw - 39rem);
        padding-right: calc(50vw - 39rem);
      }
      .band--2 { background: var(--ground-2); }
      .band--3 { background: var(--ground-3); }
      @media (max-width: 82rem) {
        .band { padding-left: clamp(1rem, 4vw, 3rem); padding-right: clamp(1rem, 4vw, 3rem); }
      }

      h1, h2, h3 {
        line-height: 1.18;
        font-weight: 500;
        letter-spacing: -0.014em;
      }
      /* Literata carries an optical-size axis. Using it is the difference
         between a headline that was set and one that was merely scaled. */
      /* A page opens on its title, so give it room to be one. The extra space
         beneath is deliberate: a heading crowded against its own metadata
         reads as a label, not a title. */
      h1 {
        font-size: var(--step-4, var(--step-3));
        font-variation-settings: 'opsz' 72;
        letter-spacing: -0.02em;
        line-height: 1.06;
        margin: 0 0 1.1rem;
        text-wrap: balance;
      }
      /* The metadata line under a title: quiet, tracked, and separated from
         the body by a rule rather than by guesswork. */
      h1 + .meta {
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--rule);
        margin-bottom: 2.6rem;
        font-size: 0.78rem;
        letter-spacing: 0.05em;
        color: var(--type-muted);
      }
      h2 {
        font-size: var(--step-2);
        font-variation-settings: 'opsz' 48;
        letter-spacing: -0.022em;
        line-height: 1.08;
        max-width: 22ch;
        /* Space above a heading is what separates sections; space below is
           what glues the heading to its own text. The gap between them should
           be lopsided, and generously so. */
        margin: 4.6rem 0 1rem;
      }
      h3 { font-size: var(--step-1); margin: 2.6rem 0 0.6rem; }

      /* A short amber rule above each section heading. One quiet repeated
         gesture, doing the work that a heavier hierarchy would need. */
      main h2::before {
        content: '';
        display: block;
        width: 26px;
        height: 1px;
        background: var(--amber);
        opacity: 0.55;
        margin-bottom: 0.85rem;
      }

      p, li { max-width: var(--measure); }
      a { color: var(--amber); text-underline-offset: 3px; }

      .lede {
        font-size: var(--step-1);
        line-height: 1.58;
        color: var(--type);
      }
      .muted { color: var(--type-muted); }
      .small { font-size: var(--step--1); }

      /* Metadata lines: hairline separators, never middle dots. */
      .meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.85rem;
        max-width: none;
        font-size: var(--step--1);
        color: var(--type-muted);
      }
      .meta .sep { width: 1px; height: 0.9em; background: var(--rule); }

      /* Monospace is for aligned numeric columns, where alignment is
         functional. Not for labels, not for metadata. */
      .num {
        font-family: var(--mono);
        font-variant-numeric: tabular-nums;
        font-size: 0.9em;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
      }
      /* Hairline rules are functional on dense almanac tables. That
         justification does not extend to the rest of the site. */
      th, td {
        text-align: left;
        /* Row height is what separates a table you read from one you squint
           at. The rules stay hairline; the air does the work. */
        padding: 0.72rem 1.1rem 0.72rem 0;
        border-bottom: 1px solid var(--rule);
      }
      th {
        font-weight: 500;
        color: var(--type-muted);
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
      }
      /* A row label in a two-column readout is not a column heading and should
         not shout like one. */
      tbody tr > th:first-child {
        text-transform: none;
        letter-spacing: 0;
        font-size: 0.88rem;
        color: var(--type);
      }
      tbody tr { transition: background-color 140ms ease; }
      tbody tr:hover { background: color-mix(in srgb, var(--panel) 55%, transparent); }
      tbody tr:last-child th, tbody tr:last-child td { border-bottom: none; }
      td.n, th.n {
        text-align: right;
        font-family: var(--mono);
        font-variant-numeric: tabular-nums;
        padding-right: 0;
      }
      th.n { font-family: var(--serif); }
      .table-scroll { overflow-x: auto; }

      .fault { color: var(--fault); }
      .ok { color: var(--amber); }

      .panel {
        background: var(--panel);
        border: 1px solid var(--rule);
        padding: 1.1rem 1.25rem;
      }

      /* This must be impossible to miss and must not read as an error dialog.
         A boxed red alert says something broke. A rule with a small coloured
         label says the page is telling you what it is. Same information,
         different register. */
      .banner {
        border: none;
        border-left: 2px solid var(--fault);
        background: none;
        padding: 0.1rem 0 0.1rem 1.15rem;
        font-size: 0.9rem;
        margin: 0 0 2.6rem;
        max-width: 60rem;
      }
      .banner strong {
        display: block;
        color: var(--fault);
        font-weight: 500;
        font-size: 0.72rem;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        margin-bottom: 0.45rem;
      }
      .banner p { max-width: none; margin: 0.35rem 0 0; }

      footer {
        border-top: 1px solid var(--rule);
        padding: 1.6rem clamp(1rem, 4vw, 3rem) 3rem;
      }
      footer p { color: var(--type-muted); font-size: 0.86rem; margin: 0; }
      .foot-lede { max-width: 62ch; }
      .foot-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 1.6rem 2.4rem;
        margin: 1.8rem 0 1.4rem;
        padding-top: 1.4rem;
        border-top: 1px solid var(--rule);
      }
      .foot-grid h3 {
        font-size: 0.72rem;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--type-muted);
        margin: 0 0 0.5rem;
        font-weight: 500;
      }
      .foot-grid p { font-size: 0.82rem; line-height: 1.55; }
      .foot-grid code {
        font-size: 0.78rem;
        color: var(--type);
        background: none;
        padding: 0;
      }
      .foot-fine {
        padding-top: 1.1rem;
        border-top: 1px solid var(--rule);
        font-size: 0.78rem;
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.001ms !important;
          transition-duration: 0.001ms !important;
        }
      }
    </style>
  </body>
</html>
