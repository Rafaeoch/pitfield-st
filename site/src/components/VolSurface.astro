---
/**
 * The fitted volatility surface, rendered from the published SVI parameters.
 *
 * The mesh is built only where the expiry actually had quotable contracts, so
 * the surface has a ragged edge: short maturities are narrow, long ones wide.
 * That edge is the data support, not a styling choice. Drawing a rectangular
 * surface here would mean rendering extrapolation as though it were quotes.
 */
interface Props {
  height?: string;
  src?: string;
  id?: string;
  /** Ambient motion: the ribs walk the Ultra Violet family in step with the
   *  mark, a glow travels with the colour front, and the camera drifts. For the
   *  homepage hero. Off by default, so the analysis page stays still while
   *  someone is reading values off it. */
  ambient?: boolean;
}
const { height = '62vh', src = '/data/latest.json', id = 'surface', ambient = false } = Astro.props;
---

<figure class="surface-figure" style={`--surface-height: ${height}`}>
  <div
    class="surface-canvas"
    id={id}
    data-src={src}
    data-ambient={ambient ? 'true' : 'false'}
    role="img"
    tabindex="0"
    aria-label="Three-dimensional plot of the fitted implied volatility surface. Drag or use arrow keys to rotate."
  >
    <p class="surface-loading">Loading surface…</p>
  </div>

  <figcaption>
    <span class="axis-key"><b>x</b> log-moneyness ln(K/F)</span>
    <span class="axis-key"><b>y</b> implied volatility</span>
    <span class="axis-key"><b>z</b> maturity, √T spacing</span>
    <span class="hint">Drag to rotate, scroll to zoom, arrow keys when focused</span>
  </figcaption>
</figure>

<style>
  .surface-figure { margin: 0; }
  .surface-canvas {
    position: relative;
    height: var(--surface-height);
    min-height: 320px;
    width: 100%;
    /* The block it sits in supplies the ground. */
    background: transparent;
    cursor: grab;
    touch-action: none;
  }
  .surface-canvas:active { cursor: grabbing; }
  .surface-canvas canvas { display: block; }

  .surface-loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    color: var(--type-muted);
    font-size: 0.9rem;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.6rem;
    padding: 0.9rem 0 0;
    font-size: var(--label);
    color: var(--type-muted);
  }
  .axis-key b {
    font-weight: 500;
    color: var(--accent);
    margin-right: 0.35rem;
  }
  .hint { margin-left: auto; }
  @media (max-width: 720px) { .hint { margin-left: 0; } }
</style>

<script>
  import * as THREE from 'three';
  import { bandProgress, clockPhase, mixRgb } from '../lib/choreography';

  // The Ultra Violet family, sorted by luminance rather than by the order the
  // swatches were given. Colour here encodes a value -- implied volatility --
  // so the ramp has to rise monotonically in brightness or the surface stops
  // being readable. In the stated order Red Violet sits darker than Rhapsody
  // before it, which would put a trough in the middle of the scale.
  //
  // A single-hue family carries less perceptual range than magma did, which is
  // the real cost of this change: neighbouring vol levels are harder to tell
  // apart. Luminance ordering recovers most of it.
  const MAGMA: [number, number, number][] = [
    [0.043, 0.031, 0.078],  // near-ground, so the low end recedes
    [0.373, 0.294, 0.545],  // Ultra Violet 18-3838
    [0.545, 0.290, 0.545],  // Sparkling Grape 19-3336
    [0.659, 0.361, 0.510],  // Red Violet 17-1818
    [0.663, 0.435, 0.647],  // Mulberry 17-3014
    [0.490, 0.545, 0.780],  // Jacaranda 17-3930
    [0.851, 0.451, 0.561],  // Chateau Rose 17-2120
    [0.627, 0.576, 0.753],  // Rhapsody 16-3817
    [0.941, 0.651, 0.808],  // Prism Pink 14-2311
  ];

  function magma(t: number): THREE.Color {
    // Remap into the legible upper range: pure magma's black end vanishes
    // against a dark ground.
    const u = Math.min(Math.max(0.25 + 0.7 * t, 0), 1) * (MAGMA.length - 1);
    const i = Math.min(Math.floor(u), MAGMA.length - 2);
    const f = u - i;
    const a = MAGMA[i];
    const b = MAGMA[i + 1];
    return new THREE.Color(
      a[0] + (b[0] - a[0]) * f,
      a[1] + (b[1] - a[1]) * f,
      a[2] + (b[2] - a[2]) * f
    );
  }

  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

  async function mount(host: HTMLElement) {
    const src = host.dataset.src!;
    let payload: any;
    try {
      payload = await fetch(src).then((r) => r.json());
    } catch {
      host.innerHTML = '<p class="surface-loading">Surface data unavailable.</p>';
      return;
    }

    const rows = [...payload.surface].sort((a: any, b: any) => a.T - b.T);
    if (!rows.length) {
      host.innerHTML = '<p class="surface-loading">No fitted expiries for this day.</p>';
      return;
    }

    // Evaluate the published SVI parameters directly rather than resampling the
    // coarse grid in the payload. This is the same fitted curve at higher
    // resolution — not interpolation and not extrapolation — and each expiry is
    // still clipped to the strike range that actually had quotes, so the mesh
    // keeps its ragged edge.
    const COLS = 121;
    const kLo = Math.min(...rows.map((r: any) => r.k_min));
    const kHi = Math.max(...rows.map((r: any) => r.k_max));
    const kGrid: number[] = Array.from(
      { length: COLS },
      (_, i) => kLo + ((kHi - kLo) * i) / (COLS - 1)
    );
    const cols = COLS;

    const totalVariance = (p: any, k: number) => {
      const x = k - p.m;
      return p.a + p.b * (p.rho * x + Math.sqrt(x * x + p.sigma * p.sigma));
    };

    const grid: (number | null)[][] = rows.map((r: any) =>
      kGrid.map((k) => {
        if (k < r.k_min || k > r.k_max) return null;
        const w = totalVariance(r.svi, k);
        return w > 0 ? Math.sqrt(w / r.T) : null;
      })
    );

    let ivMin = Infinity;
    let ivMax = -Infinity;
    for (const row of grid) {
      for (const v of row) {
        if (v == null) continue;
        if (v < ivMin) ivMin = v;
        if (v > ivMax) ivMax = v;
      }
    }
    const ivSpan = ivMax - ivMin || 1;

    // Maturity is spaced on sqrt(T): linear spacing crushes the short end,
    // where the surface is most interesting.
    const yOf = (t: number) => Math.sqrt(t);
    const yMin = yOf(rows[0].T);
    const yMax = yOf(rows[rows.length - 1].T);
    const ySpan = yMax - yMin || 1;

    const kMin = kGrid[0];
    const kMax = kGrid[cols - 1];
    const kSpan = kMax - kMin || 1;

    const W = 10, D = 7.4, H = 3.1;

    const positions: number[] = [];
    const colors: number[] = [];
    const heights: number[] = [];
    for (let r = 0; r < rows.length; r++) {
      for (let c = 0; c < cols; c++) {
        const iv = grid[r][c];
        const x = ((kGrid[c] - kMin) / kSpan - 0.5) * W;
        const z = ((yOf(rows[r].T) - yMin) / ySpan - 0.5) * D;
        const norm = iv == null ? 0 : (iv - ivMin) / ivSpan;
        const y = iv == null ? 0 : norm * H;
        positions.push(x, y, z);
        heights.push(y);
        const col = magma(norm);
        colors.push(col.r, col.g, col.b);
      }
    }

    // Faces only where all four corners have data.
    const indices: number[] = [];
    for (let r = 0; r < rows.length - 1; r++) {
      for (let c = 0; c < cols - 1; c++) {
        if (
          grid[r][c] == null || grid[r][c + 1] == null ||
          grid[r + 1][c] == null || grid[r + 1][c + 1] == null
        ) continue;
        const a = r * cols + c;
        const b = r * cols + c + 1;
        const d = (r + 1) * cols + c;
        const e = (r + 1) * cols + c + 1;
        indices.push(a, d, b, b, d, e);
      }
    }

    const geometry = new THREE.BufferGeometry();
    const posAttr = new THREE.Float32BufferAttribute(positions, 3);
    geometry.setAttribute('position', posAttr);
    const colorAttr = new THREE.Float32BufferAttribute(colors, 3);
    geometry.setAttribute('color', colorAttr);
    // The value-encoded colours, kept so the travelling glow can brighten a row
    // and hand it back exactly as it was. The glow is light passing over the
    // surface, never a change to what the colours say.
    const baseColors = Float32Array.from(colors);
    geometry.setIndex(indices);
    geometry.computeVertexNormals();

    const scene = new THREE.Scene();
    const mesh = new THREE.Mesh(
      geometry,
      new THREE.MeshStandardMaterial({
        vertexColors: true,
        side: THREE.DoubleSide,
        roughness: 0.62,
        metalness: 0.04,
        flatShading: false,
      })
    );
    scene.add(mesh);

    // One rib per fitted expiry, drawn across that expiry's own quoted range.
    // These carry the structure: the surface is a fan of smiles that get wider
    // with maturity, because a one-week option five percent out of the money is
    // genuinely worth pennies and stops being quoted. Without the ribs the
    // stepped edge reads as a rendering fault rather than as the data.
    const ambient = host.dataset.ambient === 'true';
    // A rib in the mark's colours, lifted toward white so it still reads where
    // it crosses a violet stretch of the mesh underneath it.
    const RIB_LIFT = 0.28;
    const ribColour = (target: THREE.Color, i: number, j: number, f: number) => {
      const [r, g, b] = mixRgb(i, j, f);
      return target.setRGB(
        (r + (255 - r) * RIB_LIFT) / 255,
        (g + (255 - g) * RIB_LIFT) / 255,
        (b + (255 - b) * RIB_LIFT) / 255,
        THREE.SRGBColorSpace
      );
    };

    const ribs: THREE.Line[] = [];
    const contourGroup = new THREE.Group();
    for (let r = 0; r < rows.length; r++) {
      const pts: THREE.Vector3[] = [];
      for (let c = 0; c < cols; c++) {
        if (grid[r][c] == null) continue;
        const i = (r * cols + c) * 3;
        pts.push(new THREE.Vector3(positions[i], positions[i + 1] + 0.02, positions[i + 2]));
      }
      if (pts.length > 1) {
        const material = new THREE.LineBasicMaterial({
          color: 0xe6e3db,
          transparent: true,
          opacity: ambient ? 0.92 : 0.5,
        });
        // At rest an ambient rib holds Ultra Violet, as the mark's static pose
        // does; the loop takes it from there.
        if (ambient) ribColour(material.color, 0, 0, 0);
        const line = new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), material);
        line.userData.row = r;
        ribs.push(line);
        contourGroup.add(line);
      }
    }
    scene.add(contourGroup);

    scene.add(new THREE.AmbientLight(0xffffff, 0.72));
    const key = new THREE.DirectionalLight(0xffe6c4, 1.05);
    key.position.set(6, 9, 5);
    scene.add(key);
    const rim = new THREE.DirectionalLight(0x6ea0d0, 0.4);
    rim.position.set(-7, 3, -6);
    scene.add(rim);

    const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 200);
    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    host.innerHTML = '';
    host.appendChild(renderer.domElement);

    // As the homepage hero the surface fills the screen behind a headline set
    // on the left, so it is brought closer and aimed off-centre: looking at a
    // point left of the surface puts the surface right of the text.
    // Framing depends on where the headline is. On a wide screen it sits over
    // the left of the hero, so the camera aims left of the surface to push it
    // right, and above it to keep the short-dated wings -- the tallest thing
    // on it -- clear of the floating nav. On a phone the headline is below the
    // surface, so it is simply centred and pulled back to fit the narrow frame.
    const narrow = () => host.clientWidth < 720;
    let azimuth = -0.74, polar = 0.95;
    let radius = ambient ? (narrow() ? 13.5 : 10.6) : 11.0;
    let lookX = 0, lookY = 0.35;
    const aim = () => {
      lookX = ambient && !narrow() ? -1.9 : 0;
      lookY = ambient && !narrow() ? 1.25 : 0.35;
    };
    aim();
    // Drift and parallax are offsets on top of where the reader put the camera,
    // so dragging still sets the view and the motion only ever adds to it.
    let offAz = 0, offPol = 0;
    const applyCamera = () => {
      const az = azimuth + offAz;
      const po = Math.min(Math.max(polar + offPol, 0.16), 1.52);
      camera.position.set(
        radius * Math.sin(po) * Math.sin(az),
        radius * Math.cos(po),
        radius * Math.sin(po) * Math.cos(az)
      );
      camera.lookAt(lookX, lookY, 0);
    };

    const render = () => renderer.render(scene, camera);

    const resize = () => {
      aim();
      const w = host.clientWidth;
      const h = host.clientHeight;
      // setSize must update the element's CSS size too. Passing false leaves
      // the canvas at its intrinsic buffer size (width x devicePixelRatio),
      // which overflows the container on any HiDPI display.
      renderer.setSize(w, h);
      camera.aspect = w / Math.max(h, 1);
      camera.updateProjectionMatrix();
      render();
    };
    resize();
    new ResizeObserver(resize).observe(host);

    // --- interaction ----------------------------------------------------
    let dragging = false, lastX = 0, lastY = 0;
    host.addEventListener('pointerdown', (e) => {
      dragging = true;
      lastX = e.clientX;
      lastY = e.clientY;
      host.setPointerCapture(e.pointerId);
    });
    host.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      azimuth -= (e.clientX - lastX) * 0.006;
      polar = Math.min(Math.max(polar - (e.clientY - lastY) * 0.005, 0.16), 1.52);
      lastX = e.clientX;
      lastY = e.clientY;
      applyCamera();
    });
    const stop = (e: PointerEvent) => {
      dragging = false;
      try { host.releasePointerCapture(e.pointerId); } catch {}
    };
    host.addEventListener('pointerup', stop);
    host.addEventListener('pointercancel', stop);
    host.addEventListener('wheel', (e) => {
      e.preventDefault();
      radius = Math.min(Math.max(radius * Math.exp(e.deltaY * 0.0012), 8), 30);
      applyCamera();
    }, { passive: false });

    // Keyboard parity with the pointer, so the plot is operable without a mouse.
    host.addEventListener('keydown', (e) => {
      const step = 0.09;
      if (e.key === 'ArrowLeft') azimuth += step;
      else if (e.key === 'ArrowRight') azimuth -= step;
      else if (e.key === 'ArrowUp') polar = Math.max(polar - step, 0.16);
      else if (e.key === 'ArrowDown') polar = Math.min(polar + step, 1.52);
      else if (e.key === '+' || e.key === '=') radius = Math.max(radius - 0.8, 8);
      else if (e.key === '-') radius = Math.min(radius + 0.8, 30);
      else return;
      e.preventDefault();
      applyCamera();
    });

    // Off the homepage nothing animates unless a person acts on it, so every
    // interaction redraws explicitly rather than running a render loop. The
    // ambient loop below, where enabled, simply renders over these.
    host.addEventListener('pointermove', render);
    host.addEventListener('keydown', render);
    host.addEventListener('wheel', render);

    const targetAz = azimuth;
    // Rows rise one after another, nearest maturity first -- the same idea as
    // the mark turning a band at a time. Only the order of arrival is staged:
    // every row ends at exactly its fitted height.
    const STAGGER = 0.45;
    const rowRise = (t: number, r: number) => {
      const delay = (1 - r / Math.max(rows.length - 1, 1)) * STAGGER;
      return easeOut(Math.min(Math.max((t - delay) / (1 - STAGGER), 0), 1));
    };
    // `t` is linear time through the entrance; each row eases itself.
    const setProgress = (t: number) => {
      const arr = posAttr.array as Float32Array;
      for (let i = 0; i < heights.length; i++) {
        arr[i * 3 + 1] = heights[i] * (t >= 1 ? 1 : rowRise(t, Math.floor(i / cols)));
      }
      posAttr.needsUpdate = true;
      geometry.computeVertexNormals();
      // A rib sits at its row's final height, so it appears once that row has
      // arrived rather than floating above a surface still rising under it.
      for (const rib of ribs) rib.visible = t >= 1 || rowRise(t, rib.userData.row) > 0.97;
      applyCamera();
      render();
    };

    // Draw the finished surface immediately. requestAnimationFrame does not
    // fire while the document is hidden, so a page opened in a background tab
    // would otherwise show an empty canvas even after the reader switches to
    // it. Correctness first; the animation is decoration on top.
    const settled = () => {
      azimuth = targetAz;
      setProgress(1);
    };
    settled();

    // --- the one orchestrated moment: the surface settling into place ----
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function runSettleAnimation() {
      const DURATION = 1700;
      const start = performance.now();
      const startAz = targetAz - 0.5;

      function frame(now: number) {
        const t = Math.min((now - start) / DURATION, 1);
        azimuth = startAz + (targetAz - startAz) * easeOut(t);
        setProgress(t);
        if (t < 1) requestAnimationFrame(frame);
        else {
          settled();
          if (ambient) startAmbient();
        }
      }
      requestAnimationFrame(frame);
    }

    // --- ambient motion, homepage only -------------------------------------
    //
    // Three things move, and none of them is the data. The ribs walk the
    // Ultra Violet family on the same clock as the mark in the masthead, so the
    // logo and the surface it is drawn from change colour together. A glow
    // travels with the colour front, brightening each row as its rib turns and
    // handing it back unchanged. And the camera drifts slowly, leaning toward
    // the pointer. Every vertex stays exactly where the fit put it.
    //
    // Runs only while the surface is on screen: a hero scrolled out of view has
    // no business spending a battery.
    const GLOW = 0.55;
    function startAmbient() {
      let raf = 0;
      let inView = true;
      let parAz = 0, parPol = 0, aimAz = 0, aimPol = 0;
      const R = rows.length;
      const turn = new Float32Array(R);   // how far each row's rib has turned
      const glow = new Float32Array(R);
      const colours = colorAttr.array as Float32Array;

      window.addEventListener(
        'pointermove',
        (e) => {
          const b = host.getBoundingClientRect();
          const inside =
            e.clientX >= b.left && e.clientX <= b.right &&
            e.clientY >= b.top && e.clientY <= b.bottom;
          if (!inside || dragging) {
            aimAz = aimPol = 0;
            return;
          }
          aimAz = ((e.clientX - b.left) / b.width - 0.5) * 0.16;
          aimPol = ((e.clientY - b.top) / b.height - 0.5) * 0.06;
        },
        { passive: true }
      );

      const tick = (now: number) => {
        const s = now / 1000;
        // A slow turn of about thirty degrees either way over forty seconds --
        // enough to read as the surface moving, not as the page jittering --
        // with a lift on an unrelated period so the motion never visibly loops.
        // Kept short of a full turn: seen from behind, puts and calls swap
        // sides and the surface would read backwards.
        const driftAz = 0.52 * Math.sin((2 * Math.PI * s) / 40);
        const driftPol = 0.06 * Math.sin((2 * Math.PI * s) / 23 + 1.3);
        parAz += (aimAz - parAz) * 0.06;
        parPol += (aimPol - parPol) * 0.06;
        offAz = driftAz + parAz;
        offPol = driftPol + parPol;
        applyCamera();

        const { step, w } = clockPhase(now);
        for (let r = 0; r < R; r++) {
          turn[r] = bandProgress(r / Math.max(R - 1, 1), R, step, w);
          glow[r] = 4 * turn[r] * (1 - turn[r]);   // peaks as the row is mid-turn
        }
        for (const rib of ribs) {
          ribColour(
            (rib.material as THREE.LineBasicMaterial).color,
            step, step + 1, turn[rib.userData.row]
          );
        }
        for (let i = 0; i < colours.length; i += 3) {
          const k = 1 + GLOW * glow[Math.floor(i / 3 / cols)];
          colours[i] = Math.min(baseColors[i] * k, 1);
          colours[i + 1] = Math.min(baseColors[i + 1] * k, 1);
          colours[i + 2] = Math.min(baseColors[i + 2] * k, 1);
        }
        colorAttr.needsUpdate = true;

        render();
        raf = requestAnimationFrame(tick);
      };

      // Not gated on document.hidden: browsers already withhold frames from a
      // hidden tab, and gating on it can leave the loop never starting at all.
      const run = () => {
        if (!raf && inView) raf = requestAnimationFrame(tick);
      };
      const stop = () => {
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
      };
      new IntersectionObserver((entries) => {
        inView = entries[0].isIntersecting;
        inView ? run() : stop();
      }).observe(host);
      run();
    }

    if (!reduced) {
      if (!document.hidden) runSettleAnimation();
      else {
        document.addEventListener(
          'visibilitychange',
          () => { if (!document.hidden) runSettleAnimation(); },
          { once: true }
        );
      }
    }
  }

  document.querySelectorAll<HTMLElement>('.surface-canvas').forEach(mount);
</script>
