---
/**
 * The mark: a volatility surface seen edge-on, breathing.
 *
 * Six curves, each one maturity. Every curve is a smile — implied variance
 * lowest at the money and rising into both wings — and the rear curves are
 * shallower than the front ones, because the smile genuinely does flatten as
 * maturity extends. So the shape is not decoration: it is the surface this
 * archive publishes, drawn in section.
 *
 * A travelling wave runs through the stack with a phase offset per curve, so
 * the ripple passes back through the maturities rather than every line moving
 * as one. That is what makes it read as water rather than as a wobble.
 *
 * Colour travels with the wave. Each curve samples magma, the same
 * perceptually uniform colormap the volatility surface is rendered with, and
 * the sample point moves through the stack as the ripple does. So the mark
 * runs through the ramp from back to front and back again, completing a full
 * pass each cycle.
 *
 * Magma is not a brand palette. It was built for scientific visualisation so
 * that equal steps in data are equal steps in perceived brightness, and so it
 * survives colourblindness and greyscale printing. The site's amber accent is
 * a sample from it at t = 0.88, which is why the mark and the surface belong
 * to each other rather than merely matching.
 *
 * Three things it does not do. It does not animate when the reader has asked
 * for reduced motion. It does not animate while the tab is hidden or the mark
 * is scrolled out of view, because a logo has no business burning a phone
 * battery in a background tab. And it renders a correct static pose with no
 * JavaScript at all, so the masthead is never empty.
 */
interface Props { size?: number; class?: string; animate?: boolean }
const { size = 30, class: className = '', animate = true } = Astro.props;

// Magma, the ramp the surface uses. Kept in step with VolSurface.astro.
const MAGMA: [number, number, number][] = [
  [0.000, 0.001, 0.016], [0.051, 0.031, 0.161], [0.157, 0.043, 0.412],
  [0.282, 0.043, 0.431], [0.416, 0.090, 0.433], [0.549, 0.161, 0.506],
  [0.714, 0.212, 0.475], [0.871, 0.288, 0.408], [0.965, 0.435, 0.361],
  [0.996, 0.624, 0.427], [0.988, 0.992, 0.749],
];

function magma(t: number): string {
  // Remapped into the legible upper range: pure magma's black end disappears
  // against this ground.
  const u = Math.min(Math.max(0.30 + 0.66 * t, 0), 1) * (MAGMA.length - 1);
  const i = Math.min(Math.floor(u), MAGMA.length - 2);
  const f = u - i;
  const a = MAGMA[i];
  const b = MAGMA[i + 1];
  const ch = (j: number) => Math.round((a[j] + (b[j] - a[j]) * f) * 255);
  return `rgb(${ch(0)},${ch(1)},${ch(2)})`;
}

const N = 6;
const W = 110;
const H = 40;
const LIFT = 8.5;
const SMILE = 0.52;

// The static pose, rendered at build time. This is what a reader without
// JavaScript sees, and what the animation starts from.
function curve(depth: number, t = 0): string {
  const sc = 1 - 0.3 * depth;
  const phase = depth * 2.2;
  const pts: string[] = [];
  for (let j = 0; j <= 64; j++) {
    const u = j / 64;
    const k = (u - 0.5) * 2;
    const smile = (0.12 + 0.88 * k * k) * H * sc * SMILE;
    const wave = 6.0 * (1 - 0.28 * depth) * Math.sin(k * 2.2 - t + phase);
    pts.push(`${(u * W).toFixed(2)},${(H - smile - depth * LIFT + wave).toFixed(2)}`);
  }
  return 'M' + pts.join('L');
}

const lines = Array.from({ length: N }, (_, i) => {
  const depth = (N - 1 - i) / (N - 1);
  return {
    d: curve(depth),
    width: (2.5 - depth * 1.15).toFixed(2),
    opacity: (1 - depth * 0.42).toFixed(2),
    stroke: magma(1 - depth * 0.72),
    depth,
  };
});
---

<svg
  class={`mark ${className}`}
  width={size * 2.6}
  height={size}
  viewBox={`-4 -14 ${W + 8} ${H + 20}`}
  role="img"
  aria-label="Pitfield St: a volatility surface in section"
  data-animate={animate ? 'true' : 'false'}
  data-geom={JSON.stringify({ N, W, H, LIFT, SMILE, MAGMA })}
>
  {lines.map((l) => (
    <path
      class="mark-line"
      d={l.d}
      data-depth={l.depth}
      fill="none"
      stroke={l.stroke}
      stroke-width={l.width}
      opacity={l.opacity}
      stroke-linecap="round"
    />
  ))}
</svg>

<style>
  .mark { display: block; overflow: visible; }
  /* Stroke is set per curve from the colormap, and updated per frame while
     animating, so no CSS transition here: it would fight the rAF loop. */
</style>

<script>
  for (const svg of document.querySelectorAll<SVGSVGElement>('.mark[data-animate="true"]')) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) continue;

    const g = JSON.parse(svg.dataset.geom || '{}');
    const paths = [...svg.querySelectorAll<SVGPathElement>('.mark-line')];
    const depths = paths.map((p) => parseFloat(p.dataset.depth || '0'));

    // Same ramp as the static pose and as the surface itself.
    const M = g.MAGMA as [number, number, number][];
    const magma = (v: number) => {
      const u = Math.min(Math.max(0.30 + 0.66 * v, 0), 1) * (M.length - 1);
      const i = Math.min(Math.floor(u), M.length - 2);
      const f = u - i;
      const a = M[i], b = M[i + 1];
      const ch = (j: number) => Math.round((a[j] + (b[j] - a[j]) * f) * 255);
      return `rgb(${ch(0)},${ch(1)},${ch(2)})`;
    };

    // The colour front sweeps back to front and back again, a half-cycle
    // behind the wave, so the ramp appears to travel through the stack rather
    // than every curve changing hue at once.
    const colourAt = (depth: number, t: number) =>
      0.52 - depth * 0.30 + 0.46 * Math.sin(t * 0.42 - depth * 1.8);

    const build = (depth: number, t: number) => {
      const sc = 1 - 0.3 * depth;
      const phase = depth * 2.2;
      let d = '';
      for (let j = 0; j <= 64; j++) {
        const u = j / 64;
        const k = (u - 0.5) * 2;
        const smile = (0.12 + 0.88 * k * k) * g.H * sc * g.SMILE;
        const wave = 6.0 * (1 - 0.28 * depth) * Math.sin(k * 2.2 - t + phase);
        d += (j ? 'L' : 'M') + (u * g.W).toFixed(2) + ',' +
             (g.H - smile - depth * g.LIFT + wave).toFixed(2);
      }
      return d;
    };

    let raf = 0;
    let visible = true;
    const start = performance.now();

    const tick = (now: number) => {
      // Slow. A logo that moves quickly is a distraction; this should read as
      // a tide rather than an animation.
      const t = ((now - start) / 1000) * 0.55;
      for (let i = 0; i < paths.length; i++) {
        paths[i].setAttribute('d', build(depths[i], t));
        paths[i].setAttribute('stroke', magma(colourAt(depths[i], t)));
      }
      raf = requestAnimationFrame(tick);
    };

    // Deliberately not gated on document.hidden. Browsers already withhold
    // requestAnimationFrame from hidden documents, so the guard bought nothing
    // and could deadlock: a page that loaded while hidden and never afterwards
    // fired visibilitychange would leave the mark frozen for the whole visit.
    const run = () => {
      if (raf || !visible) return;
      raf = requestAnimationFrame(tick);
    };
    const stop = () => {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    };

    document.addEventListener('visibilitychange', run);
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      visible ? run() : stop();
    }).observe(svg);

    run();
  }
</script>
