---
/**
 * The mark: a volatility surface seen edge-on, breathing.
 *
 * Six curves, each one maturity. Every curve is a smile — implied variance
 * lowest at the money and rising into both wings — and the rear curves are
 * shallower than the front ones, because the smile genuinely does flatten as
 * maturity extends. So the shape is not decoration: it is the surface this
 * archive publishes, drawn in section.
 *
 * A travelling wave runs through the stack with a phase offset per curve, so
 * the ripple passes back through the maturities rather than every line moving
 * as one. That is what makes it read as water rather than as a wobble.
 *
 * Colour moves through the stack a band at a time. Every curve holds one
 * colour, then they turn to the next one by one until the whole mark is
 * uniform again, and the next colour begins. The direction alternates, so a
 * change sweeps back to front and the one after it front to back, which reads
 * as a ripple crossing and returning rather than snapping back to restart.
 *
 * The eight are the Pantone Ultra Violet family, in order: Ultra Violet,
 * Sparkling Grape, Mulberry, Jacaranda, Rhapsody, Red Violet, Chateau Rose,
 * Prism Pink. A colour every 3.2 seconds, so a full lap takes about 26.
 *
 * Ultra Violet anchors the identity and is where the static pose rests. It is
 * also the darkest of the eight at 2.6:1 against this ground, which is why
 * text elsewhere uses a lightened tint of the same hue rather than this.
 *
 * Three things it does not do. It does not animate when the reader has asked
 * for reduced motion. It does not animate while the tab is hidden or the mark
 * is scrolled out of view, because a logo has no business burning a phone
 * battery in a background tab. And it renders a correct static pose with no
 * JavaScript at all, so the masthead is never empty.
 */
interface Props { size?: number; class?: string; animate?: boolean }
const { size = 30, class: className = '', animate = true } = Astro.props;

// The Ultra Violet family, ordered dark to light so it reads as one ramp
// rather than eight unrelated swatches. Pantone spot colours have no exact
// sRGB equivalent; these are the standard approximations.
//
//   18-3838 Ultra Violet    19-3336 Sparkling Grape   17-3014 Mulberry
//   17-3930 Jacaranda       16-3817 Rhapsody          17-1818 Red Violet
//   17-2120 Chateau Rose    14-2311 Prism Pink
//
// Ultra Violet anchors it and is where the resting pose sits. It is the
// darkest of the eight, so the cycle deliberately spends most of its time
// above it: a mark that rested at 2.6:1 against this ground would be dim.
const RAMP: [number, number, number][] = [
  [0x5F, 0x4B, 0x8B],  // Ultra Violet    18-3838
  [0x8B, 0x4A, 0x8B],  // Sparkling Grape 19-3336
  [0xA9, 0x6F, 0xA5],  // Mulberry        17-3014
  [0x7D, 0x8B, 0xC7],  // Jacaranda       17-3930
  [0xA0, 0x93, 0xC0],  // Rhapsody        16-3817
  [0xA8, 0x5C, 0x82],  // Red Violet      17-1818
  [0xD9, 0x73, 0x8F],  // Chateau Rose    17-2120
  [0xF0, 0xA6, 0xCE],  // Prism Pink      14-2311
];

function mix(i: number, j: number, f: number): string {
  const a = RAMP[i % RAMP.length];
  const b = RAMP[j % RAMP.length];
  const ch = (c: number) => Math.round(a[c] + (b[c] - a[c]) * f);
  return `rgb(${ch(0)},${ch(1)},${ch(2)})`;
}

const N = 6;
const W = 110;
const H = 40;
// Deeper stacking, so the ribs read as separate curves rather than a band.
const LIFT = 15.5;
const SMILE = 0.44;
// Each maturity steps sideways as it recedes, turning a flat stack into a
// plane running away from the viewer. This is what makes it read as a surface
// on an incline rather than lines on paper.
// Kept small. This is depth, not tilt: enough that the stack reads as a plane
// receding rather than lines drawn flat, without the whole figure leaning.
const SKEW = 6;
// More travel in the wave, now that the curves have room between them.
const AMP = 7.8;
// Level. A rotated version read as leaning rather than as a surface.
const TILT = 0;
// How much shallower each receding curve is drawn. This was 0.30, which is
// closer to the truth -- the smile really does flatten with maturity -- but it
// collapsed the rear wings onto the front ones and the ribs disappeared into a
// single band at the right-hand end. Kept small so the curves stay parallel
// and the ripple stays legible: at this size the mark has to read first.
const FLAT = 0.08;

// The static pose, rendered at build time. This is what a reader without
// JavaScript sees, and what the animation starts from.
function curve(depth: number, t = 0): string {
  const sc = 1 - FLAT * depth;
  const phase = depth * 2.2;
  const pts: string[] = [];
  for (let j = 0; j <= 64; j++) {
    const u = j / 64;
    const k = (u - 0.5) * 2;
    const smile = (0.12 + 0.88 * k * k) * H * sc * SMILE;
    const wave = AMP * (1 - 0.28 * depth) * Math.sin(k * 2.2 - t + phase);
    pts.push(
      `${(u * W + depth * SKEW).toFixed(2)},${(H - smile - depth * LIFT + wave).toFixed(2)}`
    );
  }
  return 'M' + pts.join('L');
}

const lines = Array.from({ length: N }, (_, i) => {
  const depth = (N - 1 - i) / (N - 1);
  return {
    d: curve(depth),
    width: (2.5 - depth * 1.15).toFixed(2),
    opacity: (1 - depth * 0.42).toFixed(2),
    stroke: mix(0, 0, 0),
    depth,
  };
});
---

<svg
  class={`mark ${className}`}
  width={size * 2.6}
  height={size}
  viewBox={`-10 -34 ${W + SKEW + 24} ${H + LIFT + 30}`}
  role="img"
  aria-label="Pitfield St: a volatility surface in section"
  data-animate={animate ? 'true' : 'false'}
  data-geom={JSON.stringify({ N, W, H, LIFT, SMILE, RAMP, SKEW, AMP, FLAT })}
>
  <g transform={`rotate(${TILT} ${(W + SKEW) / 2} ${H / 2})`}>
  {lines.map((l) => (
    <path
      class="mark-line"
      d={l.d}
      data-depth={l.depth}
      fill="none"
      stroke={l.stroke}
      stroke-width={l.width}
      opacity={l.opacity}
      stroke-linecap="round"
    />
  ))}
  </g>
</svg>

<style>
  .mark { display: block; overflow: visible; }
  /* Stroke is set per curve from the colormap, and updated per frame while
     animating, so no CSS transition here: it would fight the rAF loop. */
</style>

<script>
  for (const svg of document.querySelectorAll<SVGSVGElement>('.mark[data-animate="true"]')) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) continue;

    const g = JSON.parse(svg.dataset.geom || '{}');
    const paths = [...svg.querySelectorAll<SVGPathElement>('.mark-line')];
    const depths = paths.map((p) => parseFloat(p.dataset.depth || '0'));

    // The whole stack holds one colour, then changes to the next a band at a
    // time until every band has turned, then the next colour begins. So the
    // mark is only ever mid-transition or uniform, never a gradient of eight.
    //
    // Direction alternates: one colour sweeps back to front, the next front to
    // back. A sweep that always ran the same way would snap back to the start
    // on every change; alternating makes it read as a ripple crossing and
    // returning.
    const R = g.RAMP as [number, number, number][];
    const mix = (i: number, j: number, f: number) => {
      const a = R[i % R.length], b = R[j % R.length];
      const ch = (c: number) => Math.round(a[c] + (b[c] - a[c]) * f);
      return `rgb(${ch(0)},${ch(1)},${ch(2)})`;
    };

    const N_BANDS = paths.length;
    const BAND_SPAN = 0.72;   // share of a step spent sweeping; the rest rests
    const OVERLAP = 1.9;      // >1 lets neighbours blend rather than snap

    const colourFor = (depth: number, step: number, w: number) => {
      // depth 0 is the front curve, 1 the rearmost.
      const order = step % 2 === 0 ? 1 - depth : depth;
      const slot = order * BAND_SPAN * (1 - 1 / N_BANDS);
      const width = (BAND_SPAN / N_BANDS) * OVERLAP;
      const f = Math.min(Math.max((w - slot) / width, 0), 1);
      // Smoothstep, so a band eases into its new colour instead of snapping.
      const e = f * f * (3 - 2 * f);
      return mix(step, step + 1, e);
    };

    const build = (depth: number, t: number) => {
      const sc = 1 - g.FLAT * depth;
      const phase = depth * 2.2;
      let d = '';
      for (let j = 0; j <= 64; j++) {
        const u = j / 64;
        const k = (u - 0.5) * 2;
        const smile = (0.12 + 0.88 * k * k) * g.H * sc * g.SMILE;
        const wave = g.AMP * (1 - 0.28 * depth) * Math.sin(k * 2.2 - t + phase);
        d += (j ? 'L' : 'M') + (u * g.W + depth * g.SKEW).toFixed(2) + ',' +
             (g.H - smile - depth * g.LIFT + wave).toFixed(2);
      }
      return d;
    };

    const SECONDS_PER_COLOUR = 3.2;   // eight colours, so a lap is ~26s

    let raf = 0;
    let visible = true;
    const start = performance.now();

    const tick = (now: number) => {
      // Slow. A logo that moves quickly is a distraction; this should read as
      // a tide rather than an animation.
      const t = ((now - start) / 1000) * 0.55;
      // One full colour every SECONDS_PER_COLOUR; eight of them per lap.
      const phase = ((now - start) / 1000) / SECONDS_PER_COLOUR;
      const step = Math.floor(phase);
      const w = phase - step;
      for (let i = 0; i < paths.length; i++) {
        paths[i].setAttribute('d', build(depths[i], t));
        paths[i].setAttribute('stroke', colourFor(depths[i], step, w));
      }
      raf = requestAnimationFrame(tick);
    };

    // Deliberately not gated on document.hidden. Browsers already withhold
    // requestAnimationFrame from hidden documents, so the guard bought nothing
    // and could deadlock: a page that loaded while hidden and never afterwards
    // fired visibilitychange would leave the mark frozen for the whole visit.
    const run = () => {
      if (raf || !visible) return;
      raf = requestAnimationFrame(tick);
    };
    const stop = () => {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    };

    document.addEventListener('visibilitychange', run);
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      visible ? run() : stop();
    }).observe(svg);

    run();
  }
</script>
