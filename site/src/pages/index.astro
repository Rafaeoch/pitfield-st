<script>
  import { bandProgress, clockPhase, mixRgb } from '../lib/choreography';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hero = document.querySelector<HTMLElement>('.hero');
  const kinetic = document.querySelector<HTMLElement>('.kinetic');
  const caret = document.querySelector<HTMLElement>('.caret');

  // The caret takes the mark's colour at each instant, lifted toward white so a
  // two-pixel bar stays visible. Cursor, logo and the surface's ribs therefore
  // turn together, on one clock.
  if (caret && hero && !reduced) {
    const LIFT = 0.25;
    let raf = 0;
    const paint = (now: number) => {
      const { step, w } = clockPhase(now);
      const [r, g, b] = mixRgb(step, step + 1, bandProgress(0, 1, step, w));
      const lift = (c: number) => Math.round(c + (255 - c) * LIFT);
      caret.style.backgroundColor = `rgb(${lift(r)},${lift(g)},${lift(b)})`;
      raf = requestAnimationFrame(paint);
    };
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !raf) raf = requestAnimationFrame(paint);
      else if (!entry.isIntersecting && raf) { cancelAnimationFrame(raf); raf = 0; }
    }).observe(hero);
  }

  // Type a phrase out, hold it, take it back, type the next. Timers rather than
  // frames: the pace is in characters, and a throttled background tab simply
  // types more slowly, which is harmless.
  if (kinetic && caret && !reduced) {
    const phrases: string[] = JSON.parse(kinetic.dataset.phrases || '[]');
    const TYPE_MS = 58, DELETE_MS = 26, HOLD_MS = 2800, GAP_MS = 420;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    (async () => {
      let i = 0;
      // Let the first phrase sit through the page's own entrance first.
      await sleep(HOLD_MS + 1400);
      for (;;) {
        caret.classList.add('is-typing');
        const current = phrases[i];
        for (let n = current.length; n >= 0; n--) {
          kinetic.textContent = current.slice(0, n);
          await sleep(DELETE_MS);
        }
        await sleep(GAP_MS);
        i = (i + 1) % phrases.length;
        const next = phrases[i];
        for (let n = 1; n <= next.length; n++) {
          kinetic.textContent = next.slice(0, n);
          await sleep(TYPE_MS);
        }
        caret.classList.remove('is-typing');
        await sleep(HOLD_MS);
      }
    })();
  }
</script>
