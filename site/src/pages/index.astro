---
import Base from '../layouts/Base.astro';
import VolSurface from '../components/VolSurface.astro';
import { getIndex, getLatest, formatSnapshotET, int, pct } from '../lib/archive';
import VolHistory from '../components/VolHistory.astro';

const index = getIndex();
const latest = getLatest();

const counters = [
  `Updated ${formatSnapshotET(latest?.snapshot_ts)}`,
  `${int(index?.n_days)} trading days archived`,
  `${int(index?.contract_days)} contract-days`,
];
---

<Base
  title="Today"
  description="A public archive of computed options-derived volatility data, published every trading day, with the code that produced it."
  wide
>
  <section class="hero">
    <VolSurface height="78vh" />

    <div class="hero-copy">
      <h1 class="hero-title">
        The volatility surface,<br />computed in the open.
      </h1>
      <p class="hero-sub">
        Every trading day: option chains in, forwards from put and call parity,
        arbitrage-free surfaces out. Published with the code that produced them
        and the quality report saying what had to be thrown away.
      </p>
      {latest && (
        <p class="hero-ribbon">
          <span><b>{latest.underlying}</b> {latest.spot?.toFixed(2)}</span>
          <span>IV<sub>30</sub> {pct(latest.metrics?.iv_30)}%</span>
          <span>{latest.arbitrage?.n_expiries_fitted} expiries</span>
          <span class="ribbon-time">{formatSnapshotET(latest.snapshot_ts)}</span>
        </p>
      )}
    </div>
  </section>

  <div class="below">
    {latest?.synthetic && (
      <p class="synthetic-note">
        <span class="dot" aria-hidden="true"></span>
        Rendered from synthetic chains. The pipeline is real; the quotes are not.
        <a href="/about/">What that means</a>
      </p>
    )}
    {!latest?.synthetic && latest?.feed && latest.feed !== 'opra' && (
      <p class="synthetic-note">
        <span class="dot" aria-hidden="true"></span>
        Computed from the <code>{latest.feed}</code> feed. These are derived
        quotes, not the OPRA consolidated tape.
        <a href="/about/">What that means</a>
      </p>
    )}

    <p class="counters">
      {counters.map((c, i) => (
        <>
          {i > 0 && <span class="sep" aria-hidden="true"></span>}
          <span class="num">{c}</span>
        </>
      ))}
    </p>

    <p class="thesis">
      Every trading day this pipeline ingests option chains, extracts forwards
      and discount rates from put–call parity, fits arbitrage-free volatility
      surfaces, and publishes the results together with the data and the code
      that produced them. The archive grows daily and nothing is ever deleted or
      revised in place. Alongside it sits a pre-registered study testing roughly
      thirty celestial and calendar hypotheses against equity returns through the
      same statistical harness. It stands as a demonstration of how readily
      data of this kind will fool you if you let it.
    </p>

    <VolHistory history={index?.history ?? []} />

    {latest && (
      <dl class="readout">
        <div>
          <dt>{latest.underlying} spot</dt>
          <dd class="num">{latest.spot?.toFixed(2)}</dd>
        </div>
        <div>
          <dt>30-day ATM implied</dt>
          <dd class="num">{pct(latest.metrics?.iv_30)}%</dd>
        </div>
        <div>
          <dt>Expiries fitted</dt>
          <dd class="num">{latest.arbitrage?.n_expiries_fitted}</dd>
        </div>
        <div>
          <dt>Butterfly condition</dt>
          <dd class="num">
            {latest.arbitrage?.n_expiries_butterfly_ok}/{latest.arbitrage?.n_expiries_fitted}
            {' '}
            <span class={latest.arbitrage?.n_expiries_butterfly_ok === latest.arbitrage?.n_expiries_fitted ? 'ok' : 'fault'}>
              {latest.arbitrage?.n_expiries_butterfly_ok === latest.arbitrage?.n_expiries_fitted ? 'pass' : 'violation'}
            </span>
          </dd>
        </div>
        <div>
          <dt>Calendar condition</dt>
          <dd class="num">
            <span class={latest.arbitrage?.calendar_ok ? 'ok' : 'fault'}>
              {latest.arbitrage?.calendar_ok ? 'pass' : `${latest.arbitrage?.n_calendar_violations} violations`}
            </span>
          </dd>
        </div>
      </dl>
    )}
  </div>
</Base>

<style>
  .hero { margin: 0; position: relative; }

  /* The surface was the whole hero, which meant arriving on a rotating chart
     with nothing telling you what it was. The copy sits over it rather than
     above it, so the first thing on screen is a claim and its evidence at the
     same time. Pointer events pass through to the canvas, which stays
     draggable underneath. */
  .hero-copy {
    position: absolute;
    left: 0;
    bottom: 0;
    width: min(46rem, 92vw);
    /* Bottom padding clears the surface's own axis legend, which sits in the
       figure's caption. Anchored flush to the bottom the copy lands straight
       on top of it. */
    padding: 0 clamp(1rem, 4vw, 3rem) clamp(4.4rem, 9vh, 5.6rem);
    pointer-events: none;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--void) 92%, transparent) 0%,
      color-mix(in srgb, var(--void) 74%, transparent) 55%,
      transparent 100%
    );
  }
  .hero-copy > * { pointer-events: auto; }

  .hero-title {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(2.1rem, 5.4vw, 4.1rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin: 0 0 0.9rem;
    color: var(--type);
    text-wrap: balance;
  }
  .hero-sub {
    max-width: 34rem;
    margin: 0 0 1.3rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--type-muted);
  }

  .hero-ribbon {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 1.6rem;
    margin: 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
    font-size: 0.84rem;
    font-variant-numeric: tabular-nums;
    color: var(--type-muted);
  }
  .hero-ribbon b { color: var(--type); font-weight: 500; letter-spacing: 0.04em; }
  .hero-ribbon sub { font-size: 0.72em; }
  .ribbon-time { margin-left: auto; opacity: 0.75; }

  /* Enter once, quietly. Anything more insistent competes with the surface,
     which is the thing actually worth looking at. */
  .hero-title, .hero-sub, .hero-ribbon { animation: rise 900ms cubic-bezier(0.16, 1, 0.3, 1) both; }
  .hero-sub { animation-delay: 90ms; }
  .hero-ribbon { animation-delay: 170ms; }
  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-title, .hero-sub, .hero-ribbon { animation: none; }
  }

  @media (max-width: 720px) {
    .hero-copy { position: static; width: auto; background: none; padding-top: 1.4rem; }
  }

  .below {
    max-width: 78rem;
    margin: 0 auto;
    padding: 2.2rem clamp(1rem, 4vw, 3rem) 0;
  }

  .synthetic-note {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    max-width: none;
    margin: 0 0 1.1rem;
    font-size: 0.86rem;
    color: var(--fault);
  }
  .synthetic-note a { color: var(--fault); }
  .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--fault); flex: none;
  }

  /* The spec's counter line, with hairline separators rather than middle dots,
     the design direction rules those out elsewhere on the site. */
  .counters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    max-width: none;
    margin: 0 0 1.8rem;
    font-size: 0.9rem;
    color: var(--type-muted);
  }
  .sep { width: 1px; height: 0.95em; background: var(--rule); }

  .thesis {
    font-size: 1.06rem;
    max-width: 62ch;
    margin: 0 0 2.6rem;
  }

  .readout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }
  .readout > div {
    padding: 0.9rem 1.2rem 1rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .readout dt {
    /* Small caps against a large figure: the label recedes, the number reads
       first. How a terminal or a tear sheet sets a data band, and the reason
       it looks considered rather than merely tidy. */
    font-size: 0.68rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--type-muted);
    margin-bottom: 0.45rem;
  }
  .readout dd {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
    /* Tabular figures so the column does not shimmer as values change. */
    font-variant-numeric: tabular-nums;
  }
  .readout dd .ok,
  .readout dd .fault {
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    vertical-align: 0.18em;
  }
</style>
