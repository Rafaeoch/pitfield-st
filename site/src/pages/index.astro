---
import Base from '../layouts/Base.astro';
import Abacus from '../components/Abacus.astro';
import Heading from '../components/Heading.astro';
import VolHistory from '../components/VolHistory.astro';
import Freshness from '../components/Freshness.astro';
import { getIndex, getLatest, formatSnapshotET, int, pct } from '../lib/archive';

import fs from 'node:fs';
import path from 'node:path';

const index = getIndex();
const latest = getLatest();

function read(file: string) {
  try {
    return JSON.parse(fs.readFileSync(path.resolve('public/data', file), 'utf8'));
  } catch {
    return null;
  }
}

// The homepage summarises what the rest of the site holds, so it reads the
// published artefacts directly rather than restating numbers by hand. Anything
// missing degrades to a hidden section instead of a broken one.
const study = read('study.json');
const results = study?.results ?? [];
const sig = {
  raw: results.filter((r: any) => r.p_value < 0.05).length,
  bonf: results.filter((r: any) => (r.p_bonferroni ?? 1) < 0.05).length,
};

const m = latest?.metrics ?? {};
const arb = latest?.arbitrage ?? {};
const cov = latest?.coverage ?? {};

const sections = [
  { id: 'session', label: 'The session' },
  { id: 'premium', label: 'Implied against realized' },
  { id: 'pipeline', label: 'What the pipeline does' },
  { id: 'studies', label: 'A standing demonstration' },
];
---

<Base
  title="Today"
  description="A public archive of computed options-derived volatility data, published every trading day, with the code that produced it."
  theme="dark"
  sections={sections}
  bleed
>
  {/* The first screen. The surface stays put while three statements pass
      over it; the second, which explains how to read it, picks out one
      expiry as it goes by. */}
  <section class="stage">
    <div class="stage-sticky">
      <Abacus latest={latest} />
    </div>
    <div class="statements">
      <div class="statement">
        <h1>Pitfield St is a public archive of the options market, computed in the open.</h1>
      </div>
      <div class="statement" data-focus-trigger>
        <p>Each line is a strike. Each point is one expiry's implied volatility at the last close, and the points of one expiry trace its smile.</p>
      </div>
      <div class="statement">
        <p>Refitted every trading day. Never overwritten. Published with the code that made it.</p>
      </div>
    </div>
  </section>

  <div class="home-body">
    <div class="page">
      <Heading level={1} no="1">Today</Heading>
      <p>
        Every trading day this pipeline takes the option chain, extracts
        forwards and discount rates from put and call parity, fits
        arbitrage-free volatility surfaces, and publishes the results with the
        code that produced them and a report of what it had to throw away. The
        archive grows by a session a day and nothing in it is revised in place.
      </p>

      {latest?.synthetic && (
        <div class="banner" role="note"><strong>Synthetic chains.</strong><p>The pipeline is real; the quotes are not. <a href="/about/#data">What that means</a></p></div>
      )}
      {!latest?.synthetic && latest?.feed && latest.feed !== 'opra' && (
        <div class="banner" role="note">
          <strong>Derived quotes, not the consolidated tape.</strong>
          <p>
            Computed from Alpaca's <code>{latest.feed}</code> feed, an estimate
            rather than the OPRA record. <a href="/about/#data">What that means</a>
          </p>
        </div>
      )}

      <Freshness latestDate={index?.latest_date} />

      <Heading no="1.1" id="session">The session</Heading>
      <p>
        One snapshot a trading day, taken after the close. These are the
        numbers behind the points above.
      </p>
      <dl class="figures">
        <div><dt>{latest?.underlying ?? 'SPY'} close</dt><dd>{latest?.spot?.toFixed(2) ?? '—'}</dd></div>
        <div><dt>30-day implied</dt><dd>{pct(m.iv_30)}<small>%</small></dd></div>
        <div><dt>21-day realized</dt><dd>{pct(m.rv_cc_21)}<small>%</small></dd></div>
        <div><dt>Risk reversal, 25&Delta;</dt><dd>{pct(m.risk_reversal_25d)}<small>%</small></dd></div>
        <div><dt>Term slope, 90 &minus; 30</dt><dd>{pct(m.term_slope_90_30)}<small>%</small></dd></div>
      </dl>
      <p class="note counters">
        <span>Updated {formatSnapshotET(latest?.snapshot_ts)}</span>
        <span>{int(index?.n_days)} trading days archived</span>
        <span>{int(index?.contract_days)} contract-days</span>
      </p>

      <Heading no="1.2" id="premium">Implied against realized</Heading>
      <p>
        Implied volatility sits above the volatility that follows it most of
        the time, and the gap between the two is the variance risk premium.
        It is the most robust finding in the options literature, and it is
        visible here without a model, a fit or a claim.
      </p>
      <div class="full">
        <VolHistory history={index?.history ?? []} />
      </div>

      <Heading no="1.3" id="pipeline">What the pipeline does</Heading>
      <p>
        Four steps, each one checkable. The code that performed them is public,
        and so is the report of what it discarded.
      </p>
      <div class="full stagger">
        <div>
          <h3>Extract the forward</h3>
          <p>
            Put and call parity gives the forward and the discount rate from the
            chain itself, so nothing depends on an assumed dividend stream.
          </p>
        </div>
        <div>
          <h3>Invert to implied volatility</h3>
          <p>
            Black-76 on the extracted forward, solved by Brent, and weighted by
            vega, because a fit that lets the illiquid wings dominate is a fit
            of the wings.
          </p>
        </div>
      </div>
      <div class="full stagger">
        <div>
          <h3>Fit an arbitrage-free surface</h3>
          <p>
            Raw SVI per expiry under Durrleman's butterfly condition, each
            maturity floored by the one before it so total variance cannot fall
            with time.
          </p>
        </div>
        <div>
          <h3>Publish what was thrown away</h3>
          <p>
            Crossed markets, zero bids, stale quotes and fit failures are
            counted and published beside the results.
          </p>
        </div>
      </div>
      <dl class="figures">
        <div><dt>Expiries fitted</dt><dd>{arb.n_expiries_fitted ?? '—'}</dd></div>
        <div><dt>Butterfly condition</dt><dd>{arb.n_expiries_butterfly_ok ?? '—'}<small>of {arb.n_expiries_fitted ?? '—'} pass</small></dd></div>
        <div><dt>Calendar violations</dt><dd>{arb.n_calendar_violations ?? '—'}</dd></div>
        <div><dt>Chain excluded from fits</dt><dd>{pct(cov.excluded_share, 1)}<small>%</small></dd></div>
      </dl>

      <Heading no="1.4" id="studies">A standing demonstration</Heading>
      <div class="full callout">
        <p>
          Alongside the archive sits a pre-registered study of
          {' '}{study?.n_hypotheses_run ?? 'thirty'} celestial and calendar
          hypotheses, run against {study?.series?.n_sessions ? Number(study.series.n_sessions).toLocaleString('en-US') : 'decades of'} sessions
          of index returns through one statistical harness.
        </p>
        <p>
          {sig.raw} of {study?.n_tests ?? 'its'} tests look significant if you never
          correct. {sig.bonf} survive Bonferroni. It exists to show how readily
          data of this kind will fool you. <a href="/studies/">Every hypothesis, including the nulls</a>
        </p>
      </div>

      <div class="full next">
        <a class="arrow-card" href="/vol/SPY/">Today's surface in three dimensions, with every metric</a>
        <a class="arrow-card" href="/methodology/">How every number on this site is computed</a>
      </div>
    </div>
  </div>
</Base>

<style>
  /* ---- the first screen ----------------------------------------------- */
  .stage {
    position: relative;
    height: 215svh;
  }
  .stage-sticky {
    position: sticky;
    top: 0;
    height: 100svh;
  }
  .statements {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* Each statement is anchored by its foot, the first at the bottom of the
     first screen and each one after it a little over half a screen lower, so
     they arrive one at a time as the page moves. */
  .statement {
    position: absolute;
    left: var(--gutter);
    width: min(773px, calc(100% - var(--rail) - 93px));
    transform: translateY(-100%);
    transition: opacity 240ms linear;
  }
  .statement:nth-child(1) { top: calc(100svh - 90px); }
  .statement:nth-child(2) { top: calc(155svh - 90px); }
  .statement:nth-child(3) { top: calc(210svh - 90px); }
  .statement h1,
  .statement p {
    margin: 0;
    font-size: clamp(1.75rem, 1rem + 2vw, 2.52rem);
    line-height: 1.22;
    font-weight: 400;
    color: #fff;
    text-wrap: pretty;
  }
  .statement a { pointer-events: auto; }

  /* ---- below it ------------------------------------------------------- */
  .home-body {
    position: relative;
    padding: 6rem calc(var(--rail) + 33px) 0 var(--gutter);
  }
  .counters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 2rem;
    margin-top: -1.4rem !important;
  }
  .next {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.2rem;
    margin-top: 1rem;
  }

  @media (max-width: 1000px) {
    .statement { left: 20px; width: calc(100% - 40px); }
    .home-body { padding: 4rem 20px 0; }
  }
</style>

<script>
  // Scroll drives two things on the first screen: statements fade as they
  // climb into the points, and the middle statement picks out one expiry
  // while it is being read.
  const abacus = document.querySelector<HTMLElement>('.abacus');
  const statements = [...document.querySelectorAll<HTMLElement>('.statement')];
  const trigger = document.querySelector<HTMLElement>('[data-focus-trigger]');

  let queued = false;
  const update = () => {
    queued = false;
    const vh = window.innerHeight;
    for (const s of statements) {
      const foot = s.getBoundingClientRect().bottom / vh;
      // Fully present in the lower part of the screen, gone by the time the
      // foot reaches a third of the way down.
      const o = Math.min(Math.max((foot - 0.33) / 0.3, 0), 1);
      s.style.opacity = String(o);
    }
    if (abacus && trigger) {
      const r = trigger.getBoundingClientRect();
      const centre = (r.top + r.height / 2) / vh;
      const f = Math.min(Math.max(1 - Math.abs(centre - 0.72) / 0.22, 0), 1);
      abacus.dataset.focus = f.toFixed(3);
    }
  };
  addEventListener('scroll', () => {
    if (!queued) { queued = true; requestAnimationFrame(update); }
  }, { passive: true });
  addEventListener('resize', update);
  update();
</script>
