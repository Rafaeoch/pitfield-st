---
import Base from '../layouts/Base.astro';
import VolSurface from '../components/VolSurface.astro';
import { getIndex, getLatest, formatSnapshotET, int, pct } from '../lib/archive';
import VolHistory from '../components/VolHistory.astro';
import Freshness from '../components/Freshness.astro';

import fs from 'node:fs';
import path from 'node:path';

const index = getIndex();
const latest = getLatest();

function read(file: string) {
  try {
    return JSON.parse(fs.readFileSync(path.resolve('public/data', file), 'utf8'));
  } catch {
    return null;
  }
}

// The homepage summarises what the rest of the site holds, so it reads the
// published artefacts directly rather than restating numbers by hand. Anything
// missing degrades to a hidden section instead of a broken one.
const study = read('study.json');

// What the headline types. Each is a claim about the archive that a reader can
// check. "Arbitrage-free by construction" is deliberately absent: calendar
// monotonicity is enforced in the fit, but the butterfly condition is checked
// and published rather than guaranteed, so the true phrase is "checked".
const PHRASES = [
  'computed in the open.',
  'refitted every close.',
  'checked for arbitrage.',
  'never overwritten.',
  'published with its code.',
];
const lit = read('literature.json');

const results = study?.results ?? [];
const sig = {
  raw: results.filter((r: any) => r.p_value < 0.05).length,
  bh: results.filter((r: any) => (r.p_bh ?? 1) < 0.05).length,
  bonf: results.filter((r: any) => (r.p_bonferroni ?? 1) < 0.05).length,
};
const topFindings = [...results]
  .sort((a: any, b: any) => a.p_value - b.p_value)
  .slice(0, 4);

const papers = (lit?.sections ?? [])
  .flatMap((s: any) => s.papers ?? [])
  .filter((p: any) => p.note)
  .slice(0, 3);

const m = latest?.metrics ?? {};
const arb = latest?.arbitrage ?? {};
const cov = latest?.coverage ?? {};

const bp = (v: number | null | undefined) =>
  v == null ? '—' : `${(v * 10000).toFixed(1)}bp`;

const counters = [
  `Updated ${formatSnapshotET(latest?.snapshot_ts)}`,
  `${int(index?.n_days)} trading days archived`,
  `${int(index?.contract_days)} contract-days`,
];
---

<Base
  title="Today"
  description="A public archive of computed options-derived volatility data, published every trading day, with the code that produced it."
  wide
  overlay
>
  <section class="hero">
    <VolSurface height="100svh" ambient />

    <div class="hero-copy">
      <h1 class="hero-title" aria-label={`The volatility surface, ${PHRASES[0]}`}>
        <span aria-hidden="true">The volatility surface,</span><br />
        <span class="kinetic" aria-hidden="true" data-phrases={JSON.stringify(PHRASES)}>{PHRASES[0]}</span><span class="caret" aria-hidden="true"></span>
      </h1>
      <p class="hero-sub">
        Every trading day: option chains in, forwards from put and call parity,
        arbitrage-free surfaces out. Published with the code that produced them
        and the quality report saying what had to be thrown away.
      </p>
      <p class="hero-cta">
        <a class="cta" href="/vol/SPY/">Explore the surface <span aria-hidden="true">&rarr;</span></a>
        <a class="cta-quiet" href="/methodology/">How it is computed</a>
      </p>
      {latest && (
        <p class="hero-ribbon">
          <span><b>{latest.underlying}</b> {latest.spot?.toFixed(2)}</span>
          <span>IV<sub>30</sub> {pct(latest.metrics?.iv_30)}%</span>
          <span>{latest.arbitrage?.n_expiries_fitted} expiries</span>
          <span class="ribbon-time">{formatSnapshotET(latest.snapshot_ts)}</span>
        </p>
      )}
    </div>
  </section>

  <div class="below">
    {latest?.synthetic && (
      <p class="synthetic-note">
        <span class="dot" aria-hidden="true"></span>
        Rendered from synthetic chains. The pipeline is real; the quotes are not.
        <a href="/about/">What that means</a>
      </p>
    )}
    {!latest?.synthetic && latest?.feed && latest.feed !== 'opra' && (
      <p class="synthetic-note">
        <span class="dot" aria-hidden="true"></span>
        Computed from the <code>{latest.feed}</code> feed. These are derived
        quotes, not the OPRA consolidated tape.
        <a href="/about/">What that means</a>
      </p>
    )}

    <Freshness latestDate={index?.latest_date} />

    <p class="counters">
      {counters.map((c, i) => (
        <>
          {i > 0 && <span class="sep" aria-hidden="true"></span>}
          <span class="num">{c}</span>
        </>
      ))}
    </p>

    <p class="thesis">
      Every trading day this pipeline ingests option chains, extracts forwards
      and discount rates from put–call parity, fits arbitrage-free volatility
      surfaces, and publishes the results together with the data and the code
      that produced them. The archive grows daily and nothing is ever deleted or
      revised in place. Alongside it sits a pre-registered study testing roughly
      thirty celestial and calendar hypotheses against equity returns through the
      same statistical harness. It stands as a demonstration of how readily
      data of this kind will fool you if you let it.
    </p>

    <VolHistory history={index?.history ?? []} />

    {latest && (
      <dl class="readout">
        <div>
          <dt>{latest.underlying} spot</dt>
          <dd class="num">{latest.spot?.toFixed(2)}</dd>
        </div>
        <div>
          <dt>30-day ATM implied</dt>
          <dd class="num">{pct(latest.metrics?.iv_30)}%</dd>
        </div>
        <div>
          <dt>Expiries fitted</dt>
          <dd class="num">{latest.arbitrage?.n_expiries_fitted}</dd>
        </div>
        <div>
          <dt>Butterfly condition</dt>
          <dd class="num">
            {latest.arbitrage?.n_expiries_butterfly_ok}/{latest.arbitrage?.n_expiries_fitted}
            {' '}
            <span class={latest.arbitrage?.n_expiries_butterfly_ok === latest.arbitrage?.n_expiries_fitted ? 'ok' : 'fault'}>
              {latest.arbitrage?.n_expiries_butterfly_ok === latest.arbitrage?.n_expiries_fitted ? 'pass' : 'violation'}
            </span>
          </dd>
        </div>
        <div>
          <dt>Calendar condition</dt>
          <dd class="num">
            <span class={latest.arbitrage?.calendar_ok ? 'ok' : 'fault'}>
              {latest.arbitrage?.calendar_ok ? 'pass' : `${latest.arbitrage?.n_calendar_violations} violations`}
            </span>
          </dd>
        </div>
      </dl>
    )}
  </div>

  <div class="strata">

    <section class="stratum band">
      <header class="stratum-head">
        <span class="stratum-no">01</span>
        <h2>The session</h2>
        <p>
          One snapshot a trading day, taken after the close. These are the
          numbers behind the surface above.
        </p>
      </header>
      <div class="grid-4 frame">
        <div class="cell">
          <span class="cell-k">30-day implied</span>
          <span class="cell-v">{pct(m.iv_30)}%</span>
          <span class="cell-n">at the money, interpolated in total variance</span>
        </div>
        <div class="cell">
          <span class="cell-k">21-day realized</span>
          <span class="cell-v">{pct(m.rv_cc_21)}%</span>
          <span class="cell-n">close to close, annualised on 252 days</span>
        </div>
        <div class="cell">
          <span class="cell-k">Risk reversal, 25&Delta;</span>
          <span class="cell-v">{pct(m.risk_reversal_25d)}%</span>
          <span class="cell-n">put minus call: the cost of downside cover</span>
        </div>
        <div class="cell">
          <span class="cell-k">Term slope, 90 &minus; 30</span>
          <span class="cell-v">{pct(m.term_slope_90_30)}%</span>
          <span class="cell-n">{m.term_shape ?? 'shape unavailable'}</span>
        </div>
      </div>
      <p class="stratum-more"><a href="/vol/SPY/">The full surface and every metric &rarr;</a></p>
    </section>

    <section class="stratum band band--2">
      <header class="stratum-head">
        <span class="stratum-no">02</span>
        <h2>What the pipeline does</h2>
        <p>
          Four steps, every one of them checkable. The code that performed them
          is public, and so is the report of what it discarded.
        </p>
      </header>
      <ol class="steps">
        <li>
          <h3>Extract the forward</h3>
          <p>
            Put and call parity gives the forward and the discount rate from the
            chain itself, so nothing depends on an assumed dividend stream. Rate
            error grows as 1/T, so short expiries borrow the rate and keep their
            own forward.
          </p>
        </li>
        <li>
          <h3>Invert to implied volatility</h3>
          <p>
            Black-76 on the extracted forward, solved by Brent. Vega weighted,
            because a fit that lets the illiquid wings dominate is a fit of the
            wings.
          </p>
        </li>
        <li>
          <h3>Fit an arbitrage-free surface</h3>
          <p>
            Raw SVI per expiry under Durrleman's butterfly condition, each
            maturity floored by the one before it so total variance cannot fall
            with time. {arb.n_expiries_butterfly_ok ?? '—'} of {arb.n_expiries_fitted ?? '—'} expiries pass the butterfly
            condition today; calendar violations stand at {arb.n_calendar_violations ?? '—'}.
          </p>
        </li>
        <li>
          <h3>Publish what was thrown away</h3>
          <p>
            Crossed markets, zero bids, stale quotes and fit failures are counted
            and published beside the results. {pct(cov.excluded_share, 1)}% of today's chain
            did not make it into a fit.
          </p>
        </li>
      </ol>
      <p class="stratum-more"><a href="/methodology/">The methodology in full &rarr;</a></p>
    </section>

    <section class="stratum band">
      <header class="stratum-head">
        <span class="stratum-no">03</span>
        <h2>A standing demonstration</h2>
        <p>
          Alongside the archive sits a pre-registered study of {study?.n_hypotheses_run ?? '—'} celestial
          and calendar hypotheses, run against {study?.series?.n_sessions ? Number(study.series.n_sessions).toLocaleString('en-US') : '—'} sessions
          of index returns through the same statistical harness. It exists to
          show how readily data of this kind will fool you.
        </p>
      </header>
      <div class="grid-3 frame">
        <div class="cell">
          <span class="cell-k">Significant, uncorrected</span>
          <span class="cell-v">{sig.raw}</span>
          <span class="cell-n">of {study?.n_tests ?? '—'} tests at p &lt; 0.05</span>
        </div>
        <div class="cell">
          <span class="cell-k">Survive Benjamini-Hochberg</span>
          <span class="cell-v">{sig.bh}</span>
          <span class="cell-n">false discovery rate across the family</span>
        </div>
        <div class="cell">
          <span class="cell-k">Survive Bonferroni</span>
          <span class="cell-v">{sig.bonf}</span>
          <span class="cell-n">the strictest correction of the three</span>
        </div>
      </div>
      {topFindings.length > 0 && (
        <table class="findings frame">
          <thead>
            <tr><th>Hypothesis</th><th>Bucket</th><th class="n">Effect</th><th class="n">p</th></tr>
          </thead>
          <tbody>
            {topFindings.map((r: any) => (
              <tr>
                <td>{r.hypothesis.replace(/_/g, ' ')}</td>
                <td class="muted">{r.bucket.replace(/_/g, ' ')}</td>
                <td class="n">{bp(r.effect)}</td>
                <td class="n">{r.p_value < 0.00001 ? '<0.00001' : r.p_value.toFixed(5)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
      <p class="stratum-more"><a href="/studies/">Every hypothesis, including the nulls &rarr;</a></p>
    </section>

    {papers.length > 0 && (
      <section class="stratum band band--2">
        <header class="stratum-head">
          <span class="stratum-no">04</span>
          <h2>The literature behind it</h2>
          <p>
            Every method here came from somewhere. The reading list is assembled
            from OpenAlex and kept current, with a note on each paper saying what
            it contributes to this archive.
          </p>
        </header>
        <ul class="papers">
          {papers.map((p: any) => (
            <li>
              <a href={p.url}>{p.title}</a>
              <span class="paper-meta">{p.venue ?? 'preprint'}{p.year ? `, ${p.year}` : ''}</span>
              <p>{p.note.slice(0, 190)}{p.note.length > 190 ? '…' : ''}</p>
            </li>
          ))}
        </ul>
        <p class="stratum-more"><a href="/reading/">The full reading list &rarr;</a></p>
      </section>
    )}

  </div>
</Base>

<style>
  /* ---- the strata ------------------------------------------------------
     Numbered sections, each one a stratum of the archive. The rule above a
     heading and the number in the margin are doing the work that a card grid
     would otherwise do: they make the page feel surveyed rather than scrolled,
     without wrapping everything in boxes. */
  /* No measure here: each band spans the viewport and sets its own. */
  .strata { position: relative; padding-bottom: 2rem; }
  .stratum {
    position: relative;
    padding: clamp(4.5rem, 10vw, 8rem) 0;
  }
  /* A faint twelve-column rule behind each section. Structural rather than
     decorative: it shows the measure the page is set on, which is a thing
     engineering-led sites do and marketing sites never bother with. */
  .stratum::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(
      to right,
      var(--grid) 0 1px,
      transparent 1px calc(100% / 12)
    );
    z-index: 0;
  }
  /* Grey strata carry no ruling: their ground already separates them. */
  .stratum.band--2::before { display: none; }
  .stratum > * { position: relative; z-index: 1; }
  .stratum-head {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 0 1.4rem;
    margin-bottom: 2.4rem;
  }
  .stratum-no {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--accent);
    padding-top: 0.55rem;
  }
  /* The header is a two-column grid with three children, so without explicit
     placement the paragraph falls onto a second row inside the 4rem number
     column and wraps to a 64px-wide ribbon 850px tall. Both the heading and
     the paragraph belong in column two. */
  .stratum-head h2,
  .stratum-head p { grid-column: 2; }
  .stratum-head h2 {
    margin: 0 0 0.9rem;
    font-size: clamp(1.9rem, 3.8vw, 3.2rem);
    letter-spacing: -0.025em;
    line-height: 1.05;
    max-width: 18ch;
  }
  .stratum-head p {
    margin: 0;
    max-width: 46rem;
    color: var(--type-muted);
    font-size: 0.95rem;
    line-height: 1.62;
  }
  .stratum-more {
    margin: 2.2rem 0 0;
    padding-left: 5.4rem;
    font-size: 0.86rem;
  }
  .stratum-more a { color: var(--accent); text-decoration: none; }
  .stratum-more a:hover { color: var(--type); }

  /* ---- measurement cells ---------------------------------------------- */
  .grid-4, .grid-3 {
    display: grid;
    gap: 1px;
    /* The gap shows this through as the cell dividers, so the frame's own
       horizontal ruling would be hidden behind the cells anyway. Left to the
       cells, which carry the band ground. */
    background: var(--rule);
    margin-left: 5.4rem;
  }
  .grid-4.frame::before, .grid-3.frame::before { display: none; }
  .grid-4 { grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); }
  .grid-3 { grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .cell {
    background: var(--frame-bg, var(--void));
    padding: 1.3rem 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .cell-k {
    font-size: 0.66rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--type-muted);
  }
  .cell-v {
    font-size: 1.9rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  .cell-n {
    font-size: 0.76rem;
    line-height: 1.45;
    color: var(--type-muted);
  }

  /* ---- the four steps -------------------------------------------------- */
  .steps {
    list-style: none;
    counter-reset: step;
    margin: 0 0 0 5.4rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 2.2rem 2.8rem;
  }
  .steps li { counter-increment: step; position: relative; padding-top: 1.1rem; }
  .steps li::before {
    content: counter(step, decimal-leading-zero);
    position: absolute;
    top: 0;
    left: 0;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    color: var(--accent);
    opacity: 0.8;
  }
  .steps h3 { margin: 0.7rem 0 0.5rem; font-size: 1.02rem; }
  .steps p { margin: 0; font-size: 0.87rem; line-height: 1.6; color: var(--type-muted); }

  /* ---- findings table -------------------------------------------------- */
  .findings {
    margin: 2rem 0 0 5.4rem;
    width: calc(100% - 5.4rem);
    border-collapse: separate;
    border-spacing: 0;
  }
  .findings th, .findings td { padding-left: 1rem; }
  .findings th:first-child, .findings td:first-child { padding-left: 1.1rem; }
  .findings td.muted { color: var(--type-muted); }

  /* ---- papers ---------------------------------------------------------- */
  .papers {
    list-style: none;
    margin: 0 0 0 5.4rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 2rem 2.6rem;
  }
  .papers li { border-top: 1px solid var(--rule); padding-top: 1rem; }
  .papers a {
    color: var(--type);
    text-decoration: none;
    font-size: 0.98rem;
    line-height: 1.35;
    display: block;
  }
  .papers a:hover { color: var(--accent); }
  .paper-meta {
    display: block;
    margin: 0.35rem 0 0.6rem;
    font-size: 0.74rem;
    letter-spacing: 0.05em;
    color: var(--type-muted);
  }
  .papers p { margin: 0; font-size: 0.84rem; line-height: 1.58; color: var(--type-muted); }

  @media (max-width: 680px) {
    .stratum-head { grid-template-columns: 1fr; }
    .stratum-no { padding-top: 0; margin-bottom: 0.4rem; }
    .grid-4, .grid-3, .steps, .papers, .findings { margin-left: 0; }
    .findings { width: 100%; }
    .stratum-more { padding-left: 0; }
  }

  .hero { margin: 0; position: relative; }

  /* The hero is one full screen and the surface is its whole background, so
     the axis key and drag hint that sit under it elsewhere would land below
     the fold here. They stay on the surface page, where the plot is read. */
  .hero :global(.surface-figure figcaption) { display: none; }

  /* A scrim from the left, so the headline holds its contrast wherever the
     surface has turned to. Pointer events pass through: the surface underneath
     stays draggable. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--ground-1) 88%, transparent) 0%,
      color-mix(in srgb, var(--ground-1) 55%, transparent) 34%,
      transparent 62%
    );
  }
  .hero-copy { z-index: 2; }

  /* The surface was the whole hero, which meant arriving on a rotating chart
     with nothing telling you what it was. The copy sits over it rather than
     above it, so the first thing on screen is a claim and its evidence at the
     same time. Pointer events pass through to the canvas, which stays
     draggable underneath. */
  .hero-copy {
    position: absolute;
    left: 0;
    bottom: 0;
    /* Wide enough that the headline keeps its two-line break at 94px. Type
       this size dictates the measure rather than fitting into one. */
    width: min(64rem, 94vw);
    /* Bottom padding clears the surface's own axis legend, which sits in the
       figure's caption. Anchored flush to the bottom the copy lands straight
       on top of it. */
    padding: 0 clamp(1rem, 4vw, 3rem) clamp(3rem, 9vh, 6.5rem);
    pointer-events: none;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--void) 92%, transparent) 0%,
      color-mix(in srgb, var(--void) 74%, transparent) 55%,
      transparent 100%
    );
  }
  .hero-copy > * { pointer-events: auto; }

  .hero-title {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(2.3rem, 7.2vw, 5.9rem);
    line-height: 0.99;
    letter-spacing: -0.032em;
    margin: 0 0 0.9rem;
    color: var(--type);
    text-wrap: balance;
  }
  /* The typed half of the headline never wraps, so a phrase changing length
     cannot reflow the page under the reader. */
  .kinetic { white-space: nowrap; }
  .caret {
    display: inline-block;
    width: 0.055em;
    height: 0.8em;
    margin-left: 0.07em;
    vertical-align: -0.04em;
    background: var(--accent);
    animation: caret-blink 1.06s steps(1) infinite;
  }
  /* Solid while it is typing or deleting, as a real cursor is. */
  .caret.is-typing { animation: none; }
  @keyframes caret-blink { 50% { opacity: 0; } }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.8rem;
    margin: 0 0 1.6rem;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    background: var(--type);
    color: var(--ground-1);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 180ms ease, transform 180ms ease;
  }
  .cta:hover { background: var(--accent-bright, #B8ACD2); transform: translateX(2px); }
  .cta-quiet {
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--type-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 3px;
  }
  .cta-quiet:hover { color: var(--type); border-bottom-color: var(--accent); }

  .hero-sub {
    max-width: 32rem;
    margin: 0 0 1.3rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--type-muted);
  }

  .hero-ribbon {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 1.6rem;
    margin: 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
    font-size: 0.84rem;
    font-variant-numeric: tabular-nums;
    color: var(--type-muted);
  }
  .hero-ribbon b { color: var(--type); font-weight: 500; letter-spacing: 0.04em; }
  .hero-ribbon sub { font-size: 0.72em; }
  .ribbon-time { margin-left: auto; opacity: 0.75; }

  /* Enter once, quietly. Anything more insistent competes with the surface,
     which is the thing actually worth looking at. */
  .hero-title, .hero-sub, .hero-cta, .hero-ribbon { animation: rise 900ms cubic-bezier(0.16, 1, 0.3, 1) both; }
  .hero-sub { animation-delay: 90ms; }
  .hero-cta { animation-delay: 150ms; }
  .hero-ribbon { animation-delay: 210ms; }
  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-title, .hero-sub, .hero-cta, .hero-ribbon { animation: none; }
