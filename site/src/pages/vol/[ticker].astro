---
import Base from '../../layouts/Base.astro';
import VolSurface from '../../components/VolSurface.astro';
import DataProvenance from '../../components/DataProvenance.astro';
import Heading from '../../components/Heading.astro';
import { getIndex, getLatest, num, pct, money, int, formatSnapshotET } from '../../lib/archive';

export function getStaticPaths() {
  return [{ params: { ticker: 'SPY' } }];
}

const { ticker } = Astro.params;
const latest = getLatest();
const index = getIndex();

const m = latest?.metrics ?? {};
const agg = latest?.aggregates ?? {};
const cov = latest?.coverage ?? {};

const horizons = [5, 10, 21, 63, 252];
const estimators = [
  ['rv_cc', 'Close-to-close'],
  ['rv_park', 'Parkinson'],
  ['rv_gk', 'Garman–Klass'],
  ['rv_rs', 'Rogers–Satchell'],
  ['rv_yz', 'Yang–Zhang'],
];

const sections = [
  { id: 'surface', label: 'The surface' },
  { id: 'implied', label: 'Implied volatility' },
  { id: 'smile', label: 'The smile' },
  { id: 'term', label: 'Term structure' },
  { id: 'momentum', label: 'Momentum and trend' },
  { id: 'realized', label: 'Realized volatility' },
  { id: 'gamma', label: 'Gamma exposure' },
  { id: 'fit', label: 'Fit quality' },
];

const chartData = {
  k_grid: latest?.k_grid ?? [],
  surface: latest?.surface ?? [],
  gex: agg.gex_by_strike ?? [],
  flip: agg.gamma_flip_strike ?? null,
  spot: latest?.spot ?? null,
  history: index?.history ?? [],
};
---

<Base
  title={`${ticker} surface`}
  description={`Fitted volatility surface and derived metrics for ${ticker}.`}
  sections={sections}
>
  <div class="page">
  <Heading level={1} no="2">Surface</Heading>
  <p>
    The {ticker} volatility surface at the close of {latest?.date}, fitted
    expiry by expiry from the listed chain, with every metric the archive
    derives from it. Spot {latest?.spot?.toFixed(2)}, snapshot taken at
    {' '}{formatSnapshotET(latest?.snapshot_ts)}, pipeline
    version {latest?.pipeline_version}.
  </p>

  <DataProvenance synthetic={latest?.synthetic} feed={latest?.feed ?? null} />

  <Heading no="2.1" id="surface">The surface</Heading>
  <div class="full block dark surface-block">
    <VolSurface height="58vh" id="ticker-surface" />
  </div>

  <Heading no="2.2" id="implied">Implied volatility</Heading>
  <div class="pair">
    <table>
      <tbody>
        <tr><th>ATM implied, 30 day</th><td class="n">{pct(m.iv_30)}%</td></tr>
        <tr><th>ATM implied, 60 day</th><td class="n">{pct(m.iv_60)}%</td></tr>
        <tr><th>ATM implied, 90 day</th><td class="n">{pct(m.iv_90)}%</td></tr>
        <tr><th>Term slope, 90 − 30</th><td class="n">{pct(m.term_slope_90_30)}%</td></tr>
        <tr><th>Term shape</th><td class="n">{m.term_shape ?? '—'}</td></tr>
      </tbody>
    </table>
    <table>
      <tbody>
        <tr><th>IV rank, 252 day</th><td class="n">{m.iv_rank == null ? '—' : pct(m.iv_rank, 1) + '%'}</td></tr>
        <tr><th>IV percentile</th><td class="n">{m.iv_percentile == null ? '—' : pct(m.iv_percentile, 1) + '%'}</td></tr>
        <tr><th>25Δ risk reversal</th><td class="n">{pct(m.risk_reversal_25d)}%</td></tr>
        <tr><th>25Δ butterfly</th><td class="n">{pct(m.butterfly_25d)}%</td></tr>
        <tr><th>ATM skew, ∂σ/∂k</th><td class="n">{num(m.atm_skew_slope, 4)}</td></tr>
      </tbody>
    </table>
  </div>
  <p class="note">
    IV rank and percentile are computed against this ticker's own trailing
    history in the archive, {int(m.iv_history_n)} days so far, so read them as
    provisional until the window fills.
  </p>

  <Heading no="2.3" id="smile">The smile, expiry by expiry</Heading>
  <p>
    Points are market implied volatilities inverted from mid quotes; the line
    is the calibrated SVI fit. Each expiry is drawn only across the strikes
    that had a two-sided quote with open interest.
  </p>
  <div class="chart" id="chart-smile"></div>

  <Heading no="2.4" id="term">Term structure</Heading>
  <p>
    At-the-money implied volatility against days to expiry, one point per
    fitted expiry.
  </p>
  <div class="chart" id="chart-term"></div>

  <Heading no="2.5" id="momentum">Momentum and trend</Heading>
  <p>
    Computed from the underlying's own price history, not from the option
    chain. Trailing returns are simple, not annualised. The 12 minus 1 measure
    is Jegadeesh and Titman's: the twelve-month return excluding the most
    recent month, since that last month tends to reverse and including it
    contaminates the signal with short-term mean reversion.
  </p>
  <div class="pair">
    <table>
      <tbody>
        <tr><th>Return, 1 month</th><td class="n">{pct(m.return_1m, 2)}%</td></tr>
        <tr><th>Return, 3 months</th><td class="n">{pct(m.return_3m, 2)}%</td></tr>
        <tr><th>Return, 6 months</th><td class="n">{pct(m.return_6m, 2)}%</td></tr>
        <tr><th>Return, 12 months</th><td class="n">{pct(m.return_12m, 2)}%</td></tr>
        <tr><th>Momentum, 12 minus 1</th><td class="n">{pct(m.momentum_12_1, 2)}%</td></tr>
      </tbody>
    </table>
    <table>
      <tbody>
        <tr><th>Distance from 50-day average</th><td class="n">{pct(m.dist_from_ma50, 2)}%</td></tr>
        <tr><th>Distance from 200-day average</th><td class="n">{pct(m.dist_from_ma200, 2)}%</td></tr>
        <tr><th>Drawdown, current</th><td class="n">{pct(m.drawdown_current, 2)}%</td></tr>
        <tr><th>Drawdown, worst in 252 days</th><td class="n">{pct(m.drawdown_max_252, 2)}%</td></tr>
        <tr><th>Downside deviation, 252 days</th><td class="n">{pct(m.downside_deviation_252, 2)}%</td></tr>
      </tbody>
    </table>
  </div>

  <Heading level={3}>Shape of the return distribution</Heading>
  <p>
    Daily log returns over the trailing year. Excess kurtosis is measured
    against a normal distribution, so zero means normal-tailed rather than
    thin-tailed. Equity index returns are reliably negatively skewed and
    fat-tailed, which is the whole reason a volatility surface has a smile
    instead of a flat line.
  </p>
  <div class="pair">
    <table>
      <tbody>
        <tr><th>Realized skew</th><td class="n">{num(m.realized_skew, 3)}</td></tr>
        <tr><th>Realized excess kurtosis</th><td class="n">{num(m.realized_excess_kurtosis, 3)}</td></tr>
      </tbody>
    </table>
  </div>

  <Heading no="2.6" id="realized">Realized volatility</Heading>
  <p>
    Five estimators, annualised on 252 trading days. They disagree by
    construction: the range estimators use only intraday prices and are blind
    to the overnight gap, which is exactly what Yang and Zhang add back.
  </p>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Estimator</th>
          {horizons.map((h) => <th class="n">{h}d</th>)}
        </tr>
      </thead>
      <tbody>
        {estimators.map(([key, label]) => (
          <tr>
            <th>{label}</th>
            {horizons.map((h) => <td class="n">{pct(m[`${key}_${h}`])}</td>)}
          </tr>
        ))}
        <tr>
          <th>Parkinson ÷ close-to-close</th>
          {horizons.map((h) => <td class="n">{num(m[`rv_park_cc_ratio_${h}`], 3)}</td>)}
        </tr>
      </tbody>
    </table>
  </div>

  <Heading no="2.7" id="gamma">Gamma exposure</Heading>
  <div class="banner" role="note">
    <strong>The sign convention is an assumption.</strong>
    <p>
      These figures use the <code>{agg.gex_sign_convention}</code> convention:
      dealers long gamma from calls, short from puts. That assumes customers
      buy puts and sell calls, which is a generalisation about flow, not
      something anyone can observe, since no dealer's book is public. Open
      interest is previous-day settled and is dated
      {' '}{agg.oi_effective_date}, not today.
    </p>
  </div>
  <div class="pair">
    <table>
      <tbody>
        <tr><th>Total gamma exposure</th><td class="n">{money(agg.gex_total)}</td></tr>
        <tr><th>Gamma flip strike</th><td class="n">{num(agg.gamma_flip_strike, 2)}</td></tr>
        <tr><th>Max-gamma strike</th><td class="n">{num(agg.max_gamma_strike, 2)}</td></tr>
      </tbody>
    </table>
    <table>
      <tbody>
        <tr><th>Max open-interest strike</th><td class="n">{num(agg.max_oi_strike, 2)}</td></tr>
        <tr><th>Put/call ratio, volume</th><td class="n">{num(agg.put_call_ratio_volume, 3)}</td></tr>
        <tr><th>Put/call ratio, open interest</th><td class="n">{num(agg.put_call_ratio_oi, 3)}</td></tr>
      </tbody>
    </table>
  </div>
  <div class="chart" id="chart-gex"></div>

  <Heading no="2.8" id="fit">Fit quality, by expiry</Heading>
  <p>
    Every expiry the pipeline fitted today, with the forward and rate it
    extracted, how well parity held, the fit error and the margin by which the
    butterfly condition held or failed.
  </p>
  <div class="full table-scroll">
    <table>
      <thead>
        <tr>
          <th class="n">Days</th>
          <th class="n">Forward</th>
          <th class="n">Rate</th>
          <th class="n">Parity R²</th>
          <th class="n">RMSE, vol pts</th>
          <th class="n">Used</th>
          <th class="n">Dropped</th>
          <th class="n">min g(k)</th>
          <th>Butterfly</th>
        </tr>
      </thead>
      <tbody>
        {(latest?.surface ?? []).map((s: any) => (
          <tr>
            <td class="n">{s.days}</td>
            <td class="n">{num(s.forward, 2)}</td>
            <td class="n">{pct(s.rate, 3)}%</td>
            <td class="n">{num(s.parity_r2, 6)}</td>
            <td class="n">{num(s.rmse_vol_points, 3)}</td>
            <td class="n">{s.n_contracts_used}</td>
            <td class="n">{s.n_contracts_dropped}</td>
            <td class="n">{num(s.min_g, 5)}</td>
            <td class={s.butterfly_ok ? 'ok' : 'fault'}>{s.butterfly_ok ? 'pass' : 'violation'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">
    {pct(cov.excluded_share, 1)}% of the chain was excluded from the fits:
    zero-bid, crossed, no open interest, beyond the moneyness cut, or not
    invertible. The exclusion rate is published because it is part of the
    result; a surface fitted to a third of a chain is a different object from
    one fitted to all of it. Full history on <a href="/quality/">the quality page</a>.
  </p>

  <script type="application/json" id="chart-data" set:html={JSON.stringify(chartData)} />
  </div>
</Base>

<style>
  .surface-block { padding-top: 1.4rem; padding-bottom: 1.6rem; }
  .full.table-scroll { margin-top: 1rem; margin-bottom: 1.4rem; }
</style>

<script>
  import * as Plot from '@observablehq/plot';

  const el = document.getElementById('chart-data');
  if (el) {
    const data = JSON.parse(el.textContent!);

    // Read from the page's own tokens so the charts sit on whichever ground
    // the page is set in, rather than pinning colours for one of them.
    const css = getComputedStyle(document.querySelector('.page') ?? document.body);
    const token = (name: string, fallback: string) => css.getPropertyValue(name).trim() || fallback;
    const ACCENT = token('--accent', '#5F4B8B');
    const MUTED = token('--type-muted', '#6b6b6b');
    const RULE = token('--rule', '#d2d2d2');
    const TYPE = token('--type', '#252525');
    const FAULT = token('--fault', '#b3412a');

    // Expiries run from the family's palest to Ultra Violet and past it, so
    // the short end is light and the long end deep, on a white ground.
    const expiryColours = (n: number) => {
      const stops = [[0xd4, 0xcb, 0xe6], [0xa0, 0x93, 0xc0], [0x5f, 0x4b, 0x8b], [0x2a, 0x1f, 0x45]];
      return Array.from({ length: n }, (_, i) => {
        const u = (n > 1 ? i / (n - 1) : 0) * (stops.length - 1);
        const j = Math.min(Math.floor(u), stops.length - 2);
        const f = u - j;
        const c = stops[j].map((a, k) => Math.round(a + (stops[j + 1][k] - a) * f));
        return `rgb(${c[0]},${c[1]},${c[2]})`;
      });
    };

    // As wide as the column the chart sits in; Plot's default is a fixed 640.
    const width = document.getElementById('chart-smile')?.clientWidth || 640;
    const base = {
      width,
      style: { background: 'transparent', color: MUTED, fontSize: '13px', fontFamily: 'Figtree, Helvetica, Arial, sans-serif' },
      marginLeft: 58,
      marginBottom: 42,
    };

    // --- smile: market points against the fitted curve ------------------
    // k_grid is shared across expiries and lives on the payload root; each
    // surface entry carries only the values, aligned to it by index.
    const kGrid: number[] = data.k_grid;

    const smilePoints: any[] = [];
    const smileFit: any[] = [];
    for (const s of data.surface) {
      const label = `${String(s.days).padStart(3, '0')}d`;
      (s.market_k ?? []).forEach((k: number, i: number) => {
        smilePoints.push({ k, iv: s.market_iv[i] * 100, expiry: label });
      });
      s.iv_grid.forEach((v: number | null, i: number) => {
        if (v != null) smileFit.push({ k: kGrid[i], iv: v * 100, expiry: label });
      });
    }

    const smile = Plot.plot({
      ...base,
      height: 380,
      x: { label: 'log-moneyness  ln(K/F)', grid: true, tickFormat: '+.2f' },
      y: { label: 'implied volatility (%)', grid: true },
      color: { type: 'ordinal', range: expiryColours(data.surface.length), legend: true, label: 'expiry' },
      marks: [
        Plot.line(smileFit, { x: 'k', y: 'iv', z: 'expiry', stroke: 'expiry', strokeWidth: 1.6 }),
        Plot.dot(smilePoints, { x: 'k', y: 'iv', z: 'expiry', fill: 'expiry', r: 1.9, fillOpacity: 0.75 }),
      ],
    });
    document.getElementById('chart-smile')?.append(smile);

    // --- term structure --------------------------------------------------
    const term = data.surface.map((s: any) => ({
      days: s.days,
      atm: (Math.sqrt(Math.max(svi_w(s.svi, 0), 0) / s.T)) * 100,
    }));
    function svi_w(p: any, k: number) {
      const x = k - p.m;
      return p.a + p.b * (p.rho * x + Math.sqrt(x * x + p.sigma * p.sigma));
    }
    const termChart = Plot.plot({
      ...base,
      height: 260,
      x: { label: 'days to expiry', grid: true },
      y: { label: 'ATM implied volatility (%)', grid: true },
      marks: [
        Plot.line(term, { x: 'days', y: 'atm', stroke: ACCENT, strokeWidth: 1.8 }),
        Plot.dot(term, { x: 'days', y: 'atm', fill: ACCENT, r: 3 }),
      ],
    });
    document.getElementById('chart-term')?.append(termChart);

    // --- gamma exposure by strike ---------------------------------------
    const gex = data.gex.map((d: any) => ({ ...d, m: d.gex / 1e6 }));
    const gexChart = Plot.plot({
      ...base,
      height: 300,
      x: { label: 'strike', grid: true },
      y: { label: 'gamma exposure ($m per 1% move)', grid: true },
      marks: [
        Plot.ruleY([0], { stroke: RULE }),
        Plot.rectY(gex, {
          x: 'strike',
          y: 'm',
          interval: 5,
          fill: (d: any) => (d.m >= 0 ? ACCENT : FAULT),
          fillOpacity: 0.85,
        }),
        data.spot != null
          ? Plot.ruleX([data.spot], { stroke: TYPE, strokeDasharray: '3,3' })
          : null,
        data.flip != null
          ? Plot.ruleX([data.flip], { stroke: FAULT, strokeWidth: 1.4 })
          : null,
      ].filter(Boolean),
    });
    document.getElementById('chart-gex')?.append(gexChart);
  }
</script>
