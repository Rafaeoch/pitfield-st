---
import Base from '../layouts/Base.astro';
import DataProvenance from '../components/DataProvenance.astro';
import Freshness from '../components/Freshness.astro';
import Heading from '../components/Heading.astro';
import { getIndex, getLatest, num, pct, int } from '../lib/archive';

const latest = getLatest();
const index = getIndex();
const q = latest?.quality ?? {};
const cov = latest?.coverage ?? {};
const history = index?.history ?? [];

const hasFailures = (q.fit_failures?.length ?? 0) > 0;
const hasGaps = (q.strike_gaps?.length ?? 0) > 0;
const sections = [
  { id: 'today', label: 'Today' },
  ...(hasFailures ? [{ id: 'rejected', label: 'Rejected expiries' }] : []),
  ...(hasGaps ? [{ id: 'gaps', label: 'Strike grid gaps' }] : []),
  { id: 'history', label: 'History' },
];
let n = 0;
const no = () => `3.${++n}`;
---

<Base
  title="Quality"
  description="The daily quality-control report for the archive: crossed markets, zero-bid share, stale quotes, fit failures and exclusion rates."
  sections={sections}
>
  <div class="page">
  <Heading level={1} no="3">Quality</Heading>
  <p>
    What the pipeline threw away today, and why. Every exclusion is counted and
    published rather than silently dropped. The share of a chain that did not
    make it into a fit is part of the result, not an implementation detail.
  </p>

  <DataProvenance synthetic={latest?.synthetic} feed={latest?.feed ?? null} />
  <Freshness latestDate={index?.latest_date} />

  <Heading no={no()} id="today">Today, {latest?.date}</Heading>
  <dl class="figures">
    <div><dt>Day verdict</dt><dd class={q.passed ? 'ok' : 'fault'}>{q.passed ? 'Passed' : 'Failed'}</dd></div>
    <div><dt>Chain rows ingested</dt><dd>{int(q.n_rows)}</dd></div>
    <div><dt>Contracts used in fits</dt><dd>{int(cov.n_contracts_in_fits)}</dd></div>
    <div><dt>Excluded from fits</dt><dd>{pct(cov.excluded_share, 1)}<small>%</small></dd></div>
  </dl>
  <div class="pair">
    <table>
      <tbody>
        <tr><th>Expiries fitted</th><td class="n">{q.expiries_fitted}</td></tr>
        <tr><th>Expiries rejected</th><td class="n">{q.expiries_rejected}</td></tr>
        <tr><th>Stale quotes</th><td class="n">{int(q.n_stale)}</td></tr>
        <tr><th>Adjusted contracts</th><td class="n">{int(q.n_adjusted)}</td></tr>
      </tbody>
    </table>
    <table>
      <tbody>
        <tr><th>Crossed markets, bid above ask</th><td class="n">{int(q.n_crossed)} <span class="of">{pct(q.crossed_share, 2)}%</span></td></tr>
        <tr><th>Locked markets, bid equals ask</th><td class="n">{int(q.n_locked)}</td></tr>
        <tr><th>Zero-bid contracts</th><td class="n">{int(q.n_zero_bid)} <span class="of">{pct(q.zero_bid_share, 1)}%</span></td></tr>
      </tbody>
    </table>
  </div>
  <p class="note">
    A day fails on structural problems, not cosmetic ones: crossed markets
    above 1% of the chain, a collapsed row count, or no expiry fitting at all.
  </p>

  {hasFailures && (
    <>
      <Heading no={no()} id="rejected">Expiries rejected today</Heading>
      <p>
        An expiry is rejected rather than fitted badly. The reason is recorded
        with the parity fit that decided it.
      </p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th class="n">Days</th><th>Reason</th><th class="n">Parity R²</th></tr>
          </thead>
          <tbody>
            {q.fit_failures.map((f: any) => (
              <tr>
                <td class="n">{f.days}</td>
                <td class="fault">{f.reason}</td>
                <td class="n">{num(f.parity_r2, 6)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  {hasGaps && (
    <>
      <Heading no={no()} id="gaps">Strike grid gaps</Heading>
      <p>
        Increments more than twice the expiry's usual spacing. A gap is usually
        a missing listing rather than a missing quote, and it matters because
        the fit weights assume a roughly even strike grid.
      </p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Expiry</th><th class="n">After</th><th class="n">Before</th>
              <th class="n">Gap</th><th class="n">Expected</th>
            </tr>
          </thead>
          <tbody>
            {q.strike_gaps.slice(0, 12).map((g: any) => (
              <tr>
                <td class="num">{g.expiry}</td>
                <td class="n">{num(g.after_strike, 2)}</td>
                <td class="n">{num(g.before_strike, 2)}</td>
                <td class="n">{num(g.gap, 2)}</td>
                <td class="n">{num(g.expected_increment, 2)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  <Heading no={no()} id="history">History</Heading>
  <p>
    {int(history.length)} days archived. A sudden drop in row count means a
    broken source, not a quiet market, so it is tracked against a trailing
    20-day median and raises an alarm rather than a shrug.
  </p>
  <div class="chart" id="chart-quality"></div>
  <div class="chart" id="chart-exclusion"></div>

  <script type="application/json" id="quality-data" set:html={JSON.stringify({ history })} />
  </div>
</Base>

<style>
  .of { color: var(--type-muted); margin-left: 0.5rem; }
</style>

<script>
  import * as Plot from '@observablehq/plot';

  const el = document.getElementById('quality-data');
  if (el) {
    const { history } = JSON.parse(el.textContent!);
    // Read from the page's own tokens so the charts sit on its ground.
    const css = getComputedStyle(document.querySelector('.page') ?? document.body);
    const token = (name: string, fallback: string) => css.getPropertyValue(name).trim() || fallback;
    const ACCENT = token('--accent', '#5F4B8B');
    const FAULT = token('--fault', '#b3412a');
    const MUTED = token('--type-muted', '#6b6b6b');
    const width = document.getElementById('chart-quality')?.clientWidth || 640;

    const rows = history.map((d: any) => ({ ...d, date: new Date(d.date) }));
    const base = {
      width,
      style: { background: 'transparent', color: MUTED, fontSize: '13px', fontFamily: 'Figtree, Helvetica, Arial, sans-serif' },
      marginLeft: 58,
      marginBottom: 34,
      height: 220,
    };

    document.getElementById('chart-quality')?.append(
      Plot.plot({
        ...base,
        y: { label: 'share of chain (%)', grid: true },
        x: { label: null, grid: true },
        marks: [
          Plot.line(rows, {
            x: 'date',
            y: (d: any) => d.zero_bid_share * 100,
            stroke: ACCENT,
            strokeWidth: 1.5,
          }),
          Plot.line(rows, {
            x: 'date',
            y: (d: any) => d.crossed_share * 100,
            stroke: FAULT,
            strokeWidth: 1.5,
          }),
          Plot.text(['zero-bid share'], {
            frameAnchor: 'top-left', dx: 10, dy: 12, fill: ACCENT, fontSize: 11,
          }),
          Plot.text(['crossed share'], {
            frameAnchor: 'top-left', dx: 10, dy: 28, fill: FAULT, fontSize: 11,
          }),
        ],
      })
    );

    document.getElementById('chart-exclusion')?.append(
      Plot.plot({
        ...base,
        y: { label: 'excluded from fits (%)', grid: true, domain: [0, 100] },
        x: { label: null, grid: true },
        marks: [
          Plot.areaY(rows, {
            x: 'date',
            y: (d: any) => d.excluded_share * 100,
            fill: ACCENT,
            fillOpacity: 0.16,
          }),
          Plot.line(rows, {
            x: 'date',
            y: (d: any) => d.excluded_share * 100,
            stroke: ACCENT,
            strokeWidth: 1.5,
          }),
        ],
      })
    );
  }
</script>
